---
interface Props {
  type: 'writing' | 'video' | 'generic';
  compact?: boolean;
  priority?: boolean;
}

const { type, compact = false, priority = false } = Astro.props;
const image = type === 'writing'
  ? '/images/projects/haohao-shuohua.webp'
  : type === 'video'
    ? '/images/projects/video-reader.webp'
    : undefined;
const alt = type === 'writing'
  ? '纠缠的半透明墨迹逐渐收束成清晰流动的信号'
  : '连续的透明时间切片中，一个关键瞬间被琥珀色光线选中';
---

<figure class:list={['project-visual', `visual-${type}`, { compact }]}>
  {image ? (
    <img
      src={image}
      alt={alt}
      width="1536"
      height="1024"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  ) : (
    <div class="generic-skill" aria-label="可安装、可复用、可持续演化的 Agent Skill">
      <span>AGENT SKILL</span>
      <strong>Install<br />Use<br />Evolve</strong>
      <i></i>
    </div>
  )}
</figure>

<style>
  .project-visual {
    position: relative;
    width: 100%;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    isolation: isolate;
    background: #030303;
  }

  .project-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center right;
    mix-blend-mode: screen;
    mask-image:
      linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.42) 10%, black 29%, black 88%, transparent 100%),
      linear-gradient(0deg, transparent 0%, black 13%, black 88%, transparent 100%);
    mask-composite: intersect;
  }

  .visual-writing img {
    filter: saturate(0.82) contrast(1.04);
  }

  .visual-video img {
    filter: saturate(0.78) contrast(1.06);
  }

  .visual-generic {
    aspect-ratio: 3 / 2;
  }

  .generic-skill {
    position: absolute;
    inset: 0;
    display: grid;
    padding: 12%;
    align-content: center;
    border-block: 1px solid rgba(245, 185, 113, 0.2);
    background:
      linear-gradient(90deg, transparent 49.8%, rgba(245, 185, 113, 0.12) 50%, transparent 50.2%),
      linear-gradient(transparent 49.8%, rgba(245, 185, 113, 0.12) 50%, transparent 50.2%);
  }

  .generic-skill span {
    color: var(--accent);
    font: 9px var(--mono);
  }

  .generic-skill strong {
    margin-top: 18px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(34px, 5vw, 68px);
    font-weight: 400;
    line-height: 0.98;
  }

  .generic-skill i {
    position: absolute;
    right: 12%;
    bottom: 15%;
    width: 22%;
    aspect-ratio: 1;
    border: 1px solid rgba(245, 185, 113, 0.3);
    transform: rotate(45deg);
  }

  @media (max-width: 720px) {
    .project-visual img {
      object-position: 68% center;
      mask-image:
        linear-gradient(90deg, transparent 0%, black 15%, black 87%, transparent 100%),
        linear-gradient(0deg, transparent 0%, black 10%, black 90%, transparent 100%);
    }
  }
</style>
