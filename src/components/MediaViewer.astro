<dialog class="media-viewer" data-media-viewer aria-label="图片查看器">
  <div class="viewer-toolbar">
    <button type="button" data-viewer-zoom-out aria-label="缩小" title="缩小">−</button>
    <output data-viewer-scale>100%</output>
    <button type="button" data-viewer-zoom-in aria-label="放大" title="放大">＋</button>
    <button type="button" data-viewer-reset aria-label="恢复大小" title="恢复大小">1:1</button>
    <button class="viewer-close" type="button" data-viewer-close aria-label="关闭" title="关闭">×</button>
  </div>
  <div class="viewer-stage" data-viewer-stage>
    <div class="viewer-content" data-viewer-content></div>
  </div>
</dialog>

<script>
  const createImageGrid = (images: HTMLImageElement[], anchor: Element) => {
    for (let index = 0; index < images.length; index += 3) {
      const grid = document.createElement('div');
      const chunk = images.slice(index, index + 3);
      grid.className = 'media-grid';
      grid.style.setProperty('--media-columns', String(chunk.length));
      chunk.forEach((image) => grid.append(image));
      anchor.before(grid);
    }
  };

  document.querySelectorAll<HTMLElement>('.prose, .note-content, .project-prose').forEach((root) => {
    root.querySelectorAll<HTMLParagraphElement>(':scope > p').forEach((paragraph) => {
      const images = Array.from(paragraph.children).filter(
        (child): child is HTMLImageElement => child instanceof HTMLImageElement,
      );
      if (images.length < 2) return;
      createImageGrid(images, paragraph);
      if (!paragraph.textContent?.trim() && paragraph.children.length === 0) paragraph.remove();
    });

    let run: HTMLParagraphElement[] = [];
    const flushRun = () => {
      if (run.length >= 2) {
        const images = run.map((paragraph) => paragraph.querySelector('img') as HTMLImageElement);
        createImageGrid(images, run[0]);
        run.forEach((paragraph) => paragraph.remove());
      }
      run = [];
    };

    Array.from(root.children).forEach((child) => {
      const paragraph = child as HTMLParagraphElement;
      const imageOnly =
        paragraph.tagName === 'P' &&
        paragraph.children.length === 1 &&
        paragraph.firstElementChild instanceof HTMLImageElement &&
        !paragraph.textContent?.trim();
      if (imageOnly) run.push(paragraph);
      else flushRun();
    });
    flushRun();
  });

  const viewer = document.querySelector<HTMLDialogElement>('[data-media-viewer]');
  const stage = viewer?.querySelector<HTMLElement>('[data-viewer-stage]');
  const content = viewer?.querySelector<HTMLElement>('[data-viewer-content]');
  const scaleOutput = viewer?.querySelector<HTMLOutputElement>('[data-viewer-scale]');
  const targets = [
    '.feedback-loop',
    '.note-content .mermaid',
    '.prose .mermaid',
    '.project-prose .mermaid',
    '.note-content img:not(a img)',
    '.prose img:not(a img)',
    '.project-prose img:not(a img)',
  ].join(',');

  let scale = 1;
  let pinchDistance = 0;

  const applyScale = (nextScale: number) => {
    scale = Math.min(4, Math.max(0.5, nextScale));
    const media = content?.firstElementChild as HTMLElement | null;
    if (media) media.style.zoom = String(scale);
    if (scaleOutput) scaleOutput.value = `${Math.round(scale * 100)}%`;
  };

  const openViewer = (target: HTMLElement) => {
    if (!viewer || !content) return;
    content.replaceChildren();

    if (target instanceof HTMLImageElement) {
      const image = document.createElement('img');
      image.src = target.currentSrc || target.src;
      image.alt = target.alt;
      image.draggable = false;
      content.append(image);
    } else {
      const clone = target.cloneNode(true) as HTMLElement;
      clone.removeAttribute('tabindex');
      clone.removeAttribute('role');
      clone.classList.add('viewer-clone');
      content.append(clone);
    }

    applyScale(1);
    document.body.classList.add('viewer-open');
    viewer.showModal();
  };

  const closeViewer = () => {
    viewer?.close();
    document.body.classList.remove('viewer-open');
    content?.replaceChildren();
  };

  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement)?.closest<HTMLElement>(targets);
    if (!target || target.closest('a')) return;
    openViewer(target);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && viewer?.open) {
      event.preventDefault();
      closeViewer();
      return;
    }

    if ((event.key === 'Enter' || event.key === ' ') && !viewer?.open) {
      const target = (event.target as HTMLElement)?.closest<HTMLElement>(targets);
      if (target) {
        event.preventDefault();
        openViewer(target);
      }
    }
  });

  document.querySelectorAll<HTMLElement>(targets).forEach((target) => {
    if (target.closest('a')) return;
    target.tabIndex = 0;
    target.setAttribute('role', 'button');
    target.setAttribute('aria-label', `${target.getAttribute('aria-label') || '查看图片'}，点击放大`);
  });

  viewer?.querySelector('[data-viewer-close]')?.addEventListener('click', closeViewer);
  viewer?.querySelector('[data-viewer-zoom-in]')?.addEventListener('click', () => applyScale(scale + 0.25));
  viewer?.querySelector('[data-viewer-zoom-out]')?.addEventListener('click', () => applyScale(scale - 0.25));
  viewer?.querySelector('[data-viewer-reset]')?.addEventListener('click', () => applyScale(1));

  viewer?.addEventListener('click', (event) => {
    if (event.target === viewer) closeViewer();
  });

  stage?.addEventListener('click', (event) => {
    if (event.target === stage || event.target === content) closeViewer();
  });

  viewer?.addEventListener('close', () => {
    document.body.classList.remove('viewer-open');
    content?.replaceChildren();
  });

  stage?.addEventListener(
    'wheel',
    (event) => {
      if (!viewer?.open) return;
      event.preventDefault();
      applyScale(scale + (event.deltaY < 0 ? 0.12 : -0.12));
    },
    { passive: false },
  );

  stage?.addEventListener('touchstart', (event) => {
    if (event.touches.length !== 2) return;
    pinchDistance = Math.hypot(
      event.touches[0].clientX - event.touches[1].clientX,
      event.touches[0].clientY - event.touches[1].clientY,
    );
  });

  stage?.addEventListener(
    'touchmove',
    (event) => {
      if (event.touches.length !== 2 || pinchDistance === 0) return;
      event.preventDefault();
      const nextDistance = Math.hypot(
        event.touches[0].clientX - event.touches[1].clientX,
        event.touches[0].clientY - event.touches[1].clientY,
      );
      applyScale(scale * (nextDistance / pinchDistance));
      pinchDistance = nextDistance;
    },
    { passive: false },
  );

  stage?.addEventListener('touchend', () => {
    pinchDistance = 0;
  });
</script>

<style is:global>
  .feedback-loop:not(.viewer-clone),
  .note-content .mermaid,
  .prose .mermaid,
  .project-prose .mermaid,
  .note-content img:not(a img),
  .prose img:not(a img),
  .project-prose img:not(a img) {
    cursor: zoom-in;
  }

  .media-grid {
    display: grid;
    margin: 34px 0;
    gap: 12px;
    grid-template-columns: repeat(var(--media-columns), minmax(0, 1fr));
  }

  .media-grid img {
    width: 100%;
    height: 100%;
    min-height: 0;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #070707;
  }

  .feedback-loop:not(.viewer-clone):focus-visible,
  .note-content .mermaid:focus-visible,
  .prose .mermaid:focus-visible,
  .project-prose .mermaid:focus-visible,
  .note-content img:not(a img):focus-visible,
  .prose img:not(a img):focus-visible,
  .project-prose img:not(a img):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  body.viewer-open {
    overflow: hidden;
  }

  .media-viewer {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: rgba(3, 3, 3, 0.96);
    color: var(--ink);
  }

  .media-viewer::backdrop {
    background: rgba(0, 0, 0, 0.86);
    backdrop-filter: blur(8px);
  }

  .viewer-toolbar {
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 2;
    display: flex;
    height: 42px;
    align-items: center;
    gap: 2px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    background: rgba(12, 12, 12, 0.9);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.32);
  }

  .viewer-toolbar button {
    width: 42px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 17px var(--sans);
    cursor: pointer;
  }

  .viewer-toolbar button:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--accent);
  }

  .viewer-toolbar output {
    width: 52px;
    color: var(--ink-dim);
    font: 11px var(--mono);
    text-align: center;
  }

  .viewer-toolbar .viewer-close {
    margin-left: 4px;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 24px;
  }

  .viewer-stage {
    width: 100%;
    height: 100%;
    padding: 86px 48px 48px;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .viewer-content {
    display: grid;
    min-width: 100%;
    min-height: 100%;
    place-items: center;
  }

  .viewer-content > * {
    zoom: 1;
  }

  .viewer-content > img {
    display: block;
    max-width: min(90vw, 1600px);
    max-height: calc(100vh - 134px);
    object-fit: contain;
    user-select: none;
  }

  .viewer-content > .feedback-loop {
    width: min(1280px, calc(100vw - 120px));
    margin: 0;
  }

  .viewer-content > .mermaid {
    width: min(1280px, calc(100vw - 120px));
  }

  .viewer-content > .mermaid svg {
    width: 100%;
    max-width: none;
    height: auto;
  }

  @media (max-width: 720px) {
    .viewer-toolbar {
      top: 10px;
      right: 10px;
    }

    .viewer-stage {
      padding: 68px 14px 24px;
    }

    .viewer-content > .feedback-loop,
    .viewer-content > .mermaid {
      width: calc(100vw - 28px);
    }
  }

</style>
