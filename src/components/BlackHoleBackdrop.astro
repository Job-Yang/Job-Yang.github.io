---
import AmbientAudio from './AmbientAudio.astro';
import RenderingControl from './RenderingControl.astro';
---

<div class="space-static" aria-hidden="true"></div>
<canvas id="black-hole-canvas" aria-hidden="true"></canvas>
<div class="space-scrim" aria-hidden="true"></div>
<div class="plunge-veil" aria-hidden="true"></div>
<AmbientAudio />
<RenderingControl />

<script>
  import '../scripts/blackhole/scene.js';
</script>

<style>
  #black-hole-canvas,
  .space-static,
  .space-scrim {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }

  .plunge-veil {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    background: #000;
    opacity: var(--plunge-black, 0);
  }

  .space-static {
    z-index: 0;
    background:
      linear-gradient(rgba(3, 3, 3, 0.08), rgba(3, 3, 3, 0.08)),
      url("/images/blackhole-poster.webp") 68% center / cover no-repeat,
      #030303;
  }

  #black-hole-canvas {
    z-index: 0;
    display: block;
    opacity: calc(1 - var(--space-fade, 0) * 0.66);
    transition: opacity 120ms linear;
  }

  .space-scrim {
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(3, 3, 3, 0.94) 0%,
      rgba(3, 3, 3, 0.72) 34%,
      rgba(3, 3, 3, 0.16) 62%,
      transparent 100%
    );
  }

  :global(body.no-webgpu #black-hole-canvas) {
    display: none;
  }

  @media (max-width: 900px) {
    .space-scrim {
      background:
        linear-gradient(
          90deg,
          rgba(3, 3, 3, 0.95) 0%,
          rgba(3, 3, 3, 0.82) 44%,
          rgba(3, 3, 3, 0.42) 72%,
          rgba(3, 3, 3, 0.06) 100%
        ),
        linear-gradient(180deg, rgba(3, 3, 3, 0.12), rgba(3, 3, 3, 0.55));
    }
  }

  @media (max-width: 720px) {
    .space-scrim {
      background:
        linear-gradient(
          90deg,
          rgba(3, 3, 3, 0.94) 0%,
          rgba(3, 3, 3, 0.76) 58%,
          rgba(3, 3, 3, 0.18) 100%
        ),
        linear-gradient(180deg, rgba(3, 3, 3, 0.28), rgba(3, 3, 3, 0.9));
    }
  }
</style>
