---
interface Props {
  active?: 'writing' | 'notes' | 'projects' | 'about';
}

const { active } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<nav class="site-nav" aria-label="主导航">
  <div class="nav-inner">
    <span class="brand">Job Yang<span>.</span></span>
    <div class="links">
      <a class:list={{ active: isHome }} aria-current={isHome ? 'page' : undefined} href="/">首页</a>
      <a class:list={{ active: active === 'writing' }} aria-current={active === 'writing' ? 'page' : undefined} href="/writing/">写作</a>
      <a class:list={{ active: active === 'notes' }} aria-current={active === 'notes' ? 'page' : undefined} href="/notes/">手记</a>
      <a class:list={{ active: active === 'projects' }} aria-current={active === 'projects' ? 'page' : undefined} href="/projects/">沉淀</a>
      <a class:list={{ active: active === 'about' }} aria-current={active === 'about' ? 'page' : undefined} href="/about/">关于</a>
      <a href="/search/">搜索</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.025);
    backdrop-filter: saturate(120%) blur(10px);
    view-transition-name: site-nav;
  }

  .nav-inner {
    display: flex;
    width: min(calc(100% - 96px), var(--wide));
    min-height: 52px;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    color: var(--ink);
    font-size: 15px;
    font-weight: 650;
    letter-spacing: 0;
  }

  .brand span {
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: 4px;
  }

  .links a {
    position: relative;
    display: inline-flex;
    min-height: 42px;
    padding-inline: 13px;
    align-items: center;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #c8c5c0;
    font-size: 16px;
    font-weight: 560;
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .links a:hover {
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.07);
  }

  .links a.active {
    color: var(--ink);
    font-weight: 650;
  }

  .links a.active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 20px;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .nav-inner {
      width: min(calc(100% - 36px), var(--wide));
    }

    .links {
      gap: 1px;
    }

    .links a {
      min-height: 38px;
      padding-inline: 8px;
      font-size: 14px;
    }

    .brand {
      font-size: 14px;
    }

    .links a:nth-last-child(-n + 2) {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .links a:nth-child(3),
    .links a:nth-child(5) {
      display: none;
    }

    .links a {
      padding-inline: 9px;
    }
  }
</style>
