---
interface Props {
  active?: 'writing' | 'notes' | 'projects' | 'about';
  minimal?: boolean;
}

const { active, minimal = false } = Astro.props;
---

<nav class:list={['site-nav', { minimal }]} aria-label="主导航">
  <div class="nav-inner">
    <a class="brand" href="/">Job Yang<span>.</span></a>
    <div class="links">
      <a class:list={{ active: active === 'writing' }} href="/writing/">写作</a>
      {!minimal && <a class:list={{ active: active === 'notes' }} href="/notes/">手记</a>}
      {!minimal && <a class:list={{ active: active === 'projects' }} href="/projects/">沉淀</a>}
      {!minimal && <a class:list={{ active: active === 'about' }} href="/about/">关于</a>}
      <a href="/search/">搜索</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    background: rgba(3, 3, 3, 0.42);
    backdrop-filter: saturate(150%) blur(20px);
    view-transition-name: site-nav;
  }

  .nav-inner {
    display: flex;
    width: min(calc(100% - 96px), var(--wide));
    min-height: 52px;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    color: var(--ink-dim);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    opacity: 0.75;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .brand:hover {
    color: var(--ink);
    opacity: 1;
  }

  .brand span {
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: 22px;
  }

  .links a {
    position: relative;
    color: var(--ink-faint);
    font-size: 13.5px;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .links a:hover,
  .links a.active {
    color: var(--ink);
  }

  .links a.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--accent);
  }

  @media (max-width: 720px) {
    .nav-inner {
      width: min(calc(100% - 36px), var(--wide));
    }

    .links {
      gap: 14px;
    }

    .links a:nth-last-child(-n + 2) {
      display: none;
    }
  }
</style>
