---
import BaseLayout from './BaseLayout.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import LearningAssets from '../components/learning/LearningAssets.astro';
import { formatContentDate } from '../lib/dates';

interface Props {
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
  readingMinutes?: number;
  image?: string;
  courseHref?: string;
}

const {
  title,
  description,
  category,
  publishedAt,
  readingMinutes,
  image,
  courseHref,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  active="writing"
  article
  image={image}
>
  <PageBackdrop
    slot="background"
    src="/images/cosmic/article-spacetime.webp"
    position="center right"
    opacity={0.68}
    mobilePosition="72% top"
    mobileOpacity={0.34}
    effect="spacetime"
  />
  <article class="article reading">
    <header>
      <a class="back" href="/writing/">← 返回全部文章</a>
      <div class="eyebrow">{category} · {formatContentDate(publishedAt)}</div>
      <h1 class="display">{title}</h1>
      <div class="meta">
        {readingMinutes && <span>{readingMinutes} min read</span>}
      </div>
      {courseHref && (
        <a class="article-course-entry" href={courseHref}>
          <span>INTERACTIVE COURSE</span>
          <strong>不只读懂，动手把整套原理跑一遍</strong>
          <b aria-hidden="true">开始学习 →</b>
        </a>
      )}
    </header>

    <nav class="toc" id="toc" aria-label="目录"></nav>

    <div class="prose">
      <slot />
    </div>
  </article>
  {courseHref && <LearningAssets />}
</BaseLayout>

<script>
  async function renderMermaid() {
    const blocks = document.querySelectorAll<HTMLPreElement>(
      '.prose pre[data-language="mermaid"]',
    );
    if (!blocks.length) return;

    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      theme: 'dark',
      securityLevel: 'loose',
    });

    blocks.forEach((pre) => {
      const holder = document.createElement('div');
      holder.className = 'mermaid';
      holder.textContent = pre.textContent ?? '';
      pre.replaceWith(holder);
    });

    await mermaid.run({ querySelector: '.prose .mermaid' });

    document.querySelectorAll<SVGSVGElement>('.prose .mermaid svg').forEach((svg) => {
      const { width, height } = svg.viewBox.baseVal;
      if (height > 0 && width / height >= 2.2) {
        svg.closest('.mermaid')?.classList.add('mermaid--wide');
      }
    });
  }

  renderMermaid().catch((error) => console.error('[mermaid]', error));

  // Build a floating table of contents from body headings.
  const prose = document.querySelector('.prose');
  const toc = document.getElementById('toc');
  if (prose && toc) {
    const headings = Array.from(prose.querySelectorAll('h1, h2')) as HTMLElement[];
    if (headings.length >= 3) {
      const ul = document.createElement('ul');
      headings.forEach((h, i) => {
        if (!h.id) h.id = `sec-${i}`;
        const li = document.createElement('li');
        li.className = h.tagName === 'H1' ? 'lv1' : 'lv2';
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent ?? '';
        li.appendChild(a);
        ul.appendChild(li);
      });
      toc.appendChild(ul);
      toc.classList.add('ready');

      const links = Array.from(toc.querySelectorAll('a'));
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = entry.target.id;
            links.forEach((l) =>
              l.classList.toggle('active', l.getAttribute('href') === '#' + id),
            );
          });
        },
        { rootMargin: '-10% 0px -80% 0px' },
      );
      headings.forEach((h) => spy.observe(h));
    }
  }

  // Add copy buttons to code blocks.
  document
    .querySelectorAll('.prose pre:not([data-language="mermaid"])')
    .forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.type = 'button';
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = '已复制';
        setTimeout(() => (btn.textContent = '复制'), 1600);
      } catch {
        btn.textContent = '复制失败';
      }
    });
    pre.appendChild(btn);
    });
</script>

<style is:global>
  .article {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 48px), 940px);
    padding: 70px 0 110px;
  }

  .article header {
    margin-bottom: 62px;
  }

  .back {
    display: inline-block;
    margin-bottom: 50px;
    color: var(--accent);
    font-size: 14px;
    text-decoration: none;
  }

  .article h1 {
    margin: 18px 0 24px;
    font-size: clamp(40px, 6vw, 60px);
    line-height: 1.18;
    overflow-wrap: anywhere;
  }

  .description {
    margin: 0;
    color: var(--ink-dim);
    font-size: 17px;
    line-height: 1.75;
  }

  .meta {
    display: flex;
    gap: 18px;
    margin-top: 24px;
    color: var(--ink-faint);
    font: 12px var(--mono);
  }

  .article-course-entry {
    display: grid;
    min-height: 82px;
    margin-top: 30px;
    padding: 15px 17px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 5px 20px;
    border-block: 1px solid rgba(245, 185, 113, 0.35);
    color: var(--ink);
    text-decoration: none;
  }

  .article-course-entry > span {
    grid-column: 1;
    color: var(--accent);
    font: 9px var(--mono);
    letter-spacing: 0.08em;
  }

  .article-course-entry > strong {
    grid-column: 1;
    font-size: 15px;
  }

  .article-course-entry > b {
    grid-column: 2;
    grid-row: 1 / 3;
    color: var(--accent);
    font-size: 13px;
    font-weight: 560;
  }

  .article-course-entry:hover,
  .article-course-entry:focus-visible {
    background: rgba(245, 185, 113, 0.06);
  }

  .prose {
    min-width: 0;
    max-width: 100%;
    overflow-x: clip;
    color: #c5c3bf;
    font-size: 17.5px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .prose h2,
  .prose h3 {
    color: var(--ink);
    font-family: var(--serif);
    font-synthesis: none;
    font-weight: 400;
    scroll-margin-top: 90px;
  }

  .prose h1 {
    margin: 56px 0 22px;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.4;
    scroll-margin-top: 90px;
  }

  .prose h1:first-child {
    margin-top: 0;
  }

  .prose h2 {
    margin: 64px 0 22px;
    font-size: 30px;
    line-height: 1.4;
  }

  .prose h3 {
    margin: 42px 0 18px;
    font-size: 23px;
  }

  .prose p {
    margin: 0 0 28px;
  }

  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }

  .prose a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .prose .mermaid {
    display: flex;
    justify-content: center;
    max-width: 100%;
    margin: 36px 0;
    overflow-x: auto;
  }

  .prose .mermaid svg {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .prose .mermaid--wide {
      justify-content: flex-start;
      padding-bottom: 10px;
    }

    .prose .mermaid--wide svg {
      min-width: 680px;
      max-width: none;
    }
  }

  .prose .process-flow {
    display: grid;
    margin: 34px 0;
    padding: 0;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    border-block: 1px solid var(--line);
  }

  .prose .process-flow li {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 96px;
    padding: 20px 28px 20px 18px;
    place-items: center start;
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.55;
  }

  .prose .process-flow li::after {
    position: absolute;
    top: 50%;
    right: 8px;
    color: var(--accent);
    content: "→";
    font: 14px var(--mono);
    opacity: 0.62;
    transform: translateY(-50%);
  }

  .prose .process-flow li:last-child::after {
    content: none;
  }

  .prose ul,
  .prose ol {
    margin: 0 0 30px;
    padding-left: 1.4em;
  }

  .prose li {
    margin-bottom: 10px;
  }

  .prose blockquote {
    margin: 36px 0;
    padding: 2px 0 2px 24px;
    border-left: 2px solid var(--accent);
    color: var(--ink-dim);
  }

  .prose code {
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--ink);
    font: 0.88em var(--mono);
  }

  .prose pre {
    max-width: 100%;
    margin: 34px 0;
    padding: 22px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #0a0a0a;
  }

  .prose pre code {
    padding: 0;
    background: none;
  }

  .prose pre {
    position: relative;
  }

  .copy-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.5);
    color: var(--ink-dim);
    font: 11px var(--mono);
    cursor: pointer;
    opacity: 0;
    transition: opacity 160ms ease, color 160ms ease;
  }

  .prose pre:hover .copy-btn {
    opacity: 1;
  }

  .copy-btn:hover {
    color: var(--ink);
    border-color: rgba(255, 255, 255, 0.24);
  }

  @media (max-width: 680px) {
    .prose .process-flow {
      grid-template-columns: 1fr;
    }

    .prose .process-flow li {
      min-height: 0;
      padding: 16px 34px 16px 2px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.055);
    }

    .prose .process-flow li::after {
      right: 8px;
      content: "↓";
    }

    .prose .process-flow li:last-child {
      border-bottom: 0;
    }
  }

  .toc {
    display: none;
  }

  @media (min-width: 1400px) {
    .toc.ready {
      display: block;
      position: fixed;
      top: 120px;
      left: max(24px, calc((100vw - 940px) / 2 - 220px));
      width: 200px;
      max-height: 70vh;
      overflow-y: auto;
      padding-right: 12px;
    }

    .toc ul {
      margin: 0;
      padding: 0;
      list-style: none;
      border-left: 1px solid var(--line);
    }

    .toc li {
      margin: 0;
    }

    .toc a {
      display: block;
      padding: 5px 0 5px 14px;
      margin-left: -1px;
      border-left: 2px solid transparent;
      color: var(--ink-faint);
      font-size: 13px;
      line-height: 1.5;
      text-decoration: none;
      transition: color 160ms ease, border-color 160ms ease;
    }

    .toc li.lv2 a {
      padding-left: 26px;
      font-size: 12.5px;
    }

    .toc a:hover {
      color: var(--ink-dim);
    }

    .toc a.active {
      color: var(--accent);
      border-left-color: var(--accent);
    }
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .prose table {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 34px 0;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15px;
  }

  .prose thead {
    border-bottom: 1px solid var(--line);
  }

  .prose th,
  .prose td {
    padding: 11px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .prose th {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .prose td {
    color: var(--ink-dim);
    line-height: 1.7;
  }

  .prose tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .prose .callout {
    margin: 30px 0;
    padding: 16px 20px;
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: rgba(255, 255, 255, 0.035);
  }

  .prose .callout > *:last-child {
    margin-bottom: 0;
  }

  .prose .callout-label {
    margin-bottom: 8px;
    color: var(--accent);
    font: 12px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .prose .callout p {
    margin: 0 0 12px;
  }

  .prose hr {
    margin: 58px 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .article-flow {
    display: grid;
    margin: 46px 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .article-flow > div {
    position: relative;
    min-height: 142px;
    padding: 22px 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.012);
  }

  .article-flow > div::after {
    position: absolute;
    top: 50%;
    right: -7px;
    z-index: 1;
    color: var(--accent);
    content: "→";
    font: 11px var(--mono);
    transform: translateY(-50%);
  }

  .article-flow > div:nth-child(4n)::after,
  .article-flow > div:last-child::after {
    display: none;
  }

  .article-flow span {
    color: var(--accent);
    font: 9px var(--mono);
  }

  .article-flow strong {
    display: block;
    margin: 22px 0 7px;
    color: var(--ink);
    font-size: 15px;
  }

  .article-flow p {
    margin: 0;
    color: var(--ink-faint);
    font-size: 12px;
    line-height: 1.6;
  }

  .article-flow-agent {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .article-flow-agent > div:nth-child(3n)::after {
    display: none;
  }

  .article-end {
    display: flex;
    margin-top: 90px;
    padding-top: 40px;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid var(--line);
  }

  .article-end h2 {
    margin: 12px 0 6px;
    font-size: 25px;
  }

  .article-end p {
    max-width: 470px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 14px;
  }

  @media (max-width: 620px) {
    .article {
      width: min(calc(100% - 36px), 940px);
      padding-top: 48px;
    }

    .article h1 {
      font-size: 40px;
    }

    .article-course-entry {
      grid-template-columns: 1fr;
    }

    .article-course-entry > b {
      grid-column: 1;
      grid-row: auto;
      margin-top: 5px;
    }

    .prose {
      font-size: 16.5px;
    }

    .article-flow,
    .article-flow-agent {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .article-flow > div,
    .article-flow-agent > div {
      min-height: 132px;
      padding: 18px 16px;
    }

    .article-flow > div:nth-child(3n)::after {
      display: block;
    }

    .article-flow > div:nth-child(2n)::after,
    .article-flow > div:last-child::after {
      display: none;
    }

    .article-end {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
