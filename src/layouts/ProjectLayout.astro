---
import BaseLayout from './BaseLayout.astro';
import ILoopGalaxy from '../components/ILoopGalaxy.astro';
import ProjectVisual from '../components/ProjectVisual.astro';

interface Props {
  title: string;
  kind: 'system' | 'skill' | 'experiment';
  eyebrow: string;
  description: string;
  statement: string;
  github?: string;
  install?: string;
  status?: string;
  tags: string[];
  visual: 'writing' | 'video' | 'generic';
}

const { title, kind, eyebrow, description, statement, github, install, status, tags, visual } = Astro.props;
const isWriting = visual === 'writing';
const isVideo = visual === 'video';
const isSystem = kind === 'system';
const isILoop = title === 'iLoop';
---

<BaseLayout title={title} description={description} active="projects" article>
  <div class="project-background" slot="background"></div>
  <article class:list={['project-page', `project-${visual}`, `project-kind-${kind}`]}>
    <header class="project-hero wide">
      <div class="hero-copy">
        <a class="back" href="/projects/">← 返回全部沉淀</a>
        <div class="eyebrow">{eyebrow}</div>
        <h1 class="display">{isILoop ? <><em>i</em>Loop</> : title}</h1>
        <p>{statement}</p>
        <div class="hero-actions">
          {github ? (
            <a class="primary-action" href={github} target="_blank" rel="noreferrer">GitHub ↗</a>
          ) : (
            status && <span class="project-status">{status}</span>
          )}
          <a class="secondary-action" href="#story">了解它为什么存在 ↓</a>
        </div>
      </div>
      {isILoop ? (
        <div class="hero-galaxy" aria-label="iLoop 验证驱动闭环演示">
          <ILoopGalaxy />
        </div>
      ) : !isSystem && (
        <div class="hero-visual">
          <ProjectVisual type={visual} priority />
        </div>
      )}
    </header>

    {
      isSystem ? (
        <>
          <section id="story" class="story-section wide">
            <div class="section-label">01 · 为什么需要</div>
            <div class="story-heading">
              <h2 class="display">AI 写得越来越快，<br />“完成”却越来越难相信。</h2>
              <p>
                iLoop 不再给 Agent 补一层生成能力，而是补上程序员真正依赖的工作循环：
                动手前找对上下文，动手后取得真实反馈，新证据推翻旧判断时再跑一轮。
              </p>
            </div>
            <div class="system-principle">
              <blockquote>AI 说“完成了”不算数，<br />验过才算数。</blockquote>
              <p>
                这就是 VDD。完成的定义从“代码已经生成”改成“结果已经被真实反馈验证，
                并留下一份别人能重跑、能复核的证据”。
              </p>
            </div>
          </section>

          <section class="system-feedback">
            <div class="wide">
              <div class="section-label">02 · 两层验证</div>
              <div class="feedback-heading">
                <h2 class="display">执行者不能只靠自己<br />给自己判分。</h2>
                <p>
                  换一个提示词仍可能共享同一套盲区。iLoop 把“验证”拆成模型外的真实反馈，
                  以及目标不同的独立验收。
                </p>
              </div>
              <div class="feedback-pair">
                <div><span>OBSERVED</span><strong>真实反馈</strong><p>真编译、真日志、真 UI、真截图、真 Crash。模型推断不能冒充机器观测。</p></div>
                <div><span>INDEPENDENT</span><strong>独立验收</strong><p>高风险任务换一个没参与实现的 Agent，只按验收标准和证据判定。</p></div>
              </div>
            </div>
          </section>

          <section class="system-probes wide">
            <div class="section-label">03 · 按目标取证</div>
            <div class="story-heading">
              <h2 class="display">不是把所有工具跑一遍，<br />而是先问要验证什么。</h2>
              <p>
                每一轮只补最有区分度的证据缺口。这样小改动不会被全量回归拖住，
                UI 问题也不会用一段源码搜索来假装已经看过真实画面。
              </p>
            </div>
            <div class="probe-grid">
              <div><span>字段 / 状态 / 路径</span><strong>定向日志</strong></div>
              <div><span>控件存在 / 隐藏 / 位置</span><strong>UI 层级</strong></div>
              <div><span>用户最终看到什么</span><strong>截图 / 录屏</strong></div>
              <div><span>进程退出 / 崩溃位置</span><strong>Crash Report</strong></div>
            </div>
          </section>

          <section class="system-gates">
            <div class="wide">
              <div class="section-label">04 · 证据收敛</div>
              <div class="gates-heading">
                <h2 class="display">四道关没闭合，<br />就只能继续找证据。</h2>
                <a href="/writing/vdd-面向验证的开发/">阅读 VDD 方法 ↗</a>
              </div>
              <div class="gate-grid">
                <div><span>01</span><strong>时间</strong><p>证据与现象来自同一次发生。</p></div>
                <div><span>02</span><strong>范围</strong><p>覆盖实际版本、入口、端和条件。</p></div>
                <div><span>03</span><strong>机制</strong><p>解释为什么发生，不只看到相关性。</p></div>
                <div><span>04</span><strong>反证</strong><p>关键条件变化时，现象也随之变化。</p></div>
              </div>
            </div>
          </section>

          <section class="system-kernel wide">
            <div class="section-label">05 · 长任务为什么不会失控</div>
            <h2 class="display">把一次对话，变成一套<br />能持续交付的制度。</h2>
            <div class="kernel-grid">
              <div><span>01</span><strong>三档放权</strong><p>L1 只看不改，L2 在明确范围内动手，L3 必须有授权、清单和验收标准。</p></div>
              <div><span>02</span><strong>持续病例</strong><p>保存症状、假设、支持与反对证据，以及下一条最值得做的检查。</p></div>
              <div><span>03</span><strong>反循环闸门</strong><p>同一根因反复失败就停手；账号、权限和缺输入及时升级人。</p></div>
              <div><span>04</span><strong>经验召回</strong><p>可复现的工程坑进入错题本，在下一次开工前被主动召回。</p></div>
            </div>
          </section>

          <section class="system-proof wide">
            <div class="section-label">06 · 一套内核，多种 Agent</div>
            <div class="story-heading">
              <h2 class="display">判断力留在核心，<br />业务与平台做成插件。</h2>
              <p>
                内核只关心证据、能力、工作流和经验。iOS 是第一个官方插件，
                把 build、launch、日志、UI 层级、截图、Crash 和真机自动化接进同一条验证链。
              </p>
            </div>
            <div class="architecture-stack">
              <div><span>判断力</span><strong>VDD · 工作流 · 病例 · 验收 · 错题本</strong></div>
              <div><span>业务层</span><strong>领域材料 · 业务 Flow · 专项脚本 · 角色</strong></div>
              <div><span>平台层</span><strong>iOS · 日志 · 监控 · CI · IM · 设备</strong></div>
            </div>
            <a class="design-link" href="/writing/iloop-设计思路/">阅读全文：iLoop 的设计思路 →</a>
          </section>
        </>
      ) : isWriting ? (
        <>
          <section id="story" class="story-section wide">
            <div class="section-label">01 · 问题</div>
            <div class="story-heading">
              <h2 class="display">大家都闻得到 AI 味。<br />但它究竟从哪里来？</h2>
              <p>
                问题不只是“大词太多”或“喜欢排比”。更深的一层，是模型常拿英文句法组织中文：
                动词藏进名词后面，抽象判断走在事实前面，句子看起来正式，意思却越来越远。
              </p>
            </div>

            <div class="sentence-lab" data-sentence-lab>
              <div class="lab-toolbar" role="tablist" aria-label="句子对照">
                <button class="active" type="button" data-mode="diagnose">查看病灶</button>
                <button type="button" data-mode="rewrite">看改写</button>
              </div>
              <div class="lab-stage diagnose-stage">
                <p>
                  本次升级<span data-note="空壳句式">不仅仅是</span>一次简单的迭代，更是我们对整个
                  <span data-note="抽象大词">底层逻辑</span>的一次
                  <span data-note="名词化">系统性重塑</span>。
                </p>
                <div class="lab-notes">
                  <span>动作被藏起来</span>
                  <span>抽象词替代事实</span>
                  <span>用姿态代替判断</span>
                </div>
              </div>
              <div class="lab-stage rewrite-stage" hidden>
                <p>这次不只是改了几个功能。我们重新理了一遍底层逻辑。</p>
                <span>信息没有减少，句子的着力点回到了动作和事实。</span>
              </div>
            </div>
          </section>

          <section class="source-section">
            <div class="wide source-inner">
              <div class="section-label">02 · 来源</div>
              <div class="source-intro">
                <h2 class="display">这不是一份“AI 写作技巧”清单。</h2>
                <p>它把一百年来对欧化中文的研究，转成了 Agent 能执行的规则。</p>
              </div>
              <div class="source-timeline">
                <div><time>1943</time><strong>王力</strong><span>《中国现代语法》中的“欧化的语法”</span></div>
                <div><time>1972</time><strong>思果</strong><span>从翻译实践总结中文的常见病</span></div>
                <div><time>1987</time><strong>余光中</strong><span>《怎样改进英式中文？》</span></div>
                <div class="current"><time>现在</time><strong>好好说话</strong><span>把历史诊断变成可重复执行的工作流</span></div>
              </div>
            </div>
          </section>

          <section class="method-section wide">
            <div class="section-label">03 · 工作方式</div>
            <h2 class="display">先守住事实，再处理表达。</h2>
            <div class="method-flow">
              <div><span>01</span><strong>保护事实</strong><p>数字、术语、链接和引用原文不能被润色改变。</p></div>
              <div><span>02</span><strong>识别病灶</strong><p>找到翻译腔、名词化、空泛拔高和自造词。</p></div>
              <div><span>03</span><strong>重写句子</strong><p>让动词回来，让具体事实走在抽象判断前面。</p></div>
              <div><span>04</span><strong>交付前回读</strong><p>检查事实、气口和作者原本的声音是否还在。</p></div>
            </div>
          </section>
        </>
      ) : isVideo ? (
        <>
          <section id="story" class="story-section wide">
            <div class="section-label">01 · 能力缺口</div>
            <div class="story-heading">
              <h2 class="display">模型看得见图片，<br />却看不见事情如何发生。</h2>
              <p>
                很多 App 问题只存在于一段动态过程里。均匀抽帧会留下大量重复画面，
                真正出问题的瞬间反而可能一次都没被选中。
              </p>
            </div>

            <div class="frame-demo">
              <div class="frame-before">
                <span>均匀抽帧</span>
                <div class="frames">
                  <i></i><i></i><i></i><i></i><i></i><i></i>
                </div>
                <p>六张几乎相同的画面，问题发生的 11.2 秒不在里面。</p>
              </div>
              <div class="frame-after">
                <span>运动区间</span>
                <div class="motion-window">
                  <i></i><i></i><i class="key"></i><i></i>
                </div>
                <p>先找变化，再让模型只看真正有信息的瞬间。</p>
              </div>
            </div>
          </section>

          <section class="pipeline-section">
            <div class="wide">
              <div class="section-label">02 · 方法</div>
              <div class="pipeline-heading">
                <h2 class="display">不是看更多，<br />而是先选对。</h2>
                <div class="zero-token"><strong>0</strong><span>token 用于选择关键帧</span></div>
              </div>
              <div class="pipeline">
                <div><span>01</span><strong>Grid</strong><p>先看完整视频的节奏</p></div>
                <div><span>02</span><strong>Scan</strong><p>用帧差定位运动区间</p></div>
                <div><span>03</span><strong>Zoom</strong><p>放大可疑的几秒</p></div>
                <div><span>04</span><strong>Judge</strong><p>让模型理解发生了什么</p></div>
              </div>
            </div>
          </section>

          <section class="evidence-section wide">
            <div class="section-label">03 · 一次真实诊断</div>
            <h2 class="display">结论落到具体时间，<br />而不是“视频里好像有问题”。</h2>
            <div class="evidence-timeline">
              <div><time>00:09.0</time><span>开始滚动</span></div>
              <div><time>00:11.2</time><span>手指停止</span></div>
              <div class="anomaly"><time>00:11.8</time><span>面板仍继续移动</span></div>
              <div class="conclusion"><strong>结论</strong><span>交互状态异常，不是视频卡顿。</span></div>
            </div>
          </section>
        </>
      ) : null
    }

    <section class="details-section">
      <div class="details-inner wide">
        <aside>
          <div class="section-label">{isSystem ? '07 · 当前状态' : '04 · 使用与边界'}</div>
          <div class="project-facts">
            <div><span>TYPE</span><strong>{isSystem ? 'Agent System' : 'Agent Skill'}</strong></div>
            <div><span>FOCUS</span><strong>{tags.join(' / ')}</strong></div>
            {install && <div><span>INSTALL</span><code>{install}</code></div>}
            {status && <div><span>STATUS</span><strong>{status}</strong></div>}
          </div>
        </aside>
        <div class="project-prose">
          {isSystem ? (
            <>
              <h2>开源版已经发布</h2>
              <p>
                当前版本包含平台无关内核、入口协议、工作流、病例、证据 Gate、
                独立验收、错题本，以及第一个 iOS 官方插件。
              </p>
              <ul class="system-reading">
                <li><a href="/writing/iloop-设计思路/">iLoop 的完整设计思路</a></li>
                <li><a href="/writing/vdd-面向验证的开发/">VDD：让 AI 说“完成”前先自证一遍</a></li>
                <li><a href="/writing/oncall-助手/">一个真正能查问题的 Oncall 助手</a></li>
                {github && <li><a href={github} target="_blank" rel="noreferrer">GitHub 开源仓库 ↗</a></li>}
              </ul>
            </>
          ) : (
            <slot />
          )}
        </div>
      </div>
    </section>

    <footer class="project-footer wide">
      <div>
        <div class="eyebrow">{github ? 'Open Source' : 'In Progress'}</div>
        <h2 class="display">
          {github ? '源码、安装说明和后续更新都在 GitHub。' : '开源准备完成后，这里会接上正式仓库。'}
        </h2>
      </div>
      {github && <a href={github} target="_blank" rel="noreferrer">打开仓库 <span>↗</span></a>}
    </footer>
  </article>
</BaseLayout>

<script>
  const lab = document.querySelector('[data-sentence-lab]');
  if (lab) {
    const buttons = Array.from(lab.querySelectorAll<HTMLButtonElement>('[data-mode]'));
    const diagnose = lab.querySelector<HTMLElement>('.diagnose-stage');
    const rewrite = lab.querySelector<HTMLElement>('.rewrite-stage');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.dataset.mode;
        buttons.forEach((item) => item.classList.toggle('active', item === button));
        if (diagnose) diagnose.hidden = mode !== 'diagnose';
        if (rewrite) rewrite.hidden = mode !== 'rewrite';
      });
    });
  }

  document.querySelectorAll('.project-prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.type = 'button';
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = '已复制';
        setTimeout(() => (btn.textContent = '复制'), 1600);
      } catch {
        btn.textContent = '复制失败';
      }
    });
    pre.appendChild(btn);
  });
</script>

<style is:global>
  .project-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: #030303;
  }

  .project-page {
    position: relative;
    z-index: 2;
  }

  .project-hero {
    display: grid;
    min-height: calc(88svh - 52px);
    padding-block: 70px;
    grid-template-columns: minmax(360px, 0.76fr) minmax(0, 1.24fr);
    align-items: center;
    gap: 28px;
  }

  .project-kind-system .project-hero {
    min-height: calc(74svh - 52px);
    grid-template-columns: minmax(360px, 0.72fr) minmax(760px, 1.28fr);
  }

  .project-kind-system .hero-copy {
    max-width: 560px;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .back {
    display: inline-block;
    margin-bottom: 72px;
    color: var(--ink-faint);
    font-size: 13px;
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .hero-copy h1 {
    margin: 18px 0 26px;
    font-size: clamp(58px, 8vw, 104px);
    line-height: 0.98;
  }

  .hero-copy h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .hero-copy > p {
    max-width: 550px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    margin-top: 36px;
    gap: 12px;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    min-height: 44px;
    padding: 0 18px;
    align-items: center;
    border: 1px solid var(--line);
    font-size: 12px;
    text-decoration: none;
  }

  .primary-action {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  .project-status {
    display: inline-flex;
    min-height: 44px;
    padding: 0 18px;
    align-items: center;
    border: 1px solid rgba(245, 185, 113, 0.42);
    color: var(--accent);
    font: 11px var(--mono);
  }

  .primary-action:hover {
    border-color: var(--accent);
    background: var(--accent);
  }

  .secondary-action {
    color: var(--ink-dim);
  }

  .secondary-action:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero-visual {
    min-width: 0;
    aspect-ratio: 3 / 2;
  }

  .hero-galaxy {
    min-width: 0;
    width: 100%;
  }

  .hero-galaxy .galaxy-wrap {
    max-width: none;
  }

  .hero-galaxy .galaxy {
    min-height: 480px;
  }

  .hero-visual .project-visual {
    height: 100%;
  }

  .story-section,
  .method-section,
  .evidence-section {
    padding-block: 88px;
  }

  .section-label {
    color: var(--accent);
    font: 10px var(--mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .story-heading {
    display: grid;
    margin-top: 34px;
    grid-template-columns: 1.3fr 0.7fr;
    align-items: end;
    gap: 52px;
  }

  .story-heading h2,
  .source-intro h2,
  .method-section > h2,
  .pipeline-heading h2,
  .evidence-section > h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.22;
  }

  .story-heading p,
  .source-intro p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 16px;
    line-height: 1.9;
  }

  .system-principle {
    display: grid;
    margin-top: 54px;
    padding-block: 34px;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    align-items: end;
    gap: 60px;
    border-block: 1px solid var(--line);
  }

  .system-principle blockquote {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.35;
  }

  .system-principle p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 15px;
    line-height: 1.85;
  }

  .system-feedback,
  .system-gates {
    border-block: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.012);
  }

  .system-feedback > .wide,
  .system-gates > .wide,
  .system-kernel,
  .system-probes,
  .system-proof {
    padding-block: 82px;
  }

  .system-kernel > h2 {
    max-width: 850px;
    margin: 34px 0 0;
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1.18;
  }

  .feedback-heading,
  .gates-heading {
    display: grid;
    margin-top: 34px;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.6fr);
