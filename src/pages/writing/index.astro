---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpaceModel from '../../components/SpaceModel.astro';
import { formatContentDate } from '../../lib/dates';
import { getLegacyPosts } from '../../lib/legacy';
import { comparePosts } from '../../lib/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(comparePosts);
const legacyPosts = await getLegacyPosts();
const categories = [...new Set(posts.map((post) => post.data.category))];
---

<BaseLayout
  title="写作"
  description="关于 AI Agent、iOS、软件工程与实验记录的公开文章索引。"
  active="writing"
>
  <div class="space-fallback writing-background" slot="background">
    <SpaceModel model="station" class="writing-station" />
  </div>
  <div class="page-shell">
    <header class="writing-intro writing-width">
      <div class="eyebrow">Writing Index</div>
      <h1 class="display">记录思考，对抗时间的熵增。</h1>
      <p>关于 AI Agent、软件工程与技术变化的长期思考。</p>
    </header>

    <section class="writing-width filters" aria-label="文章分类">
      <button class="active" type="button" data-filter="all">全部</button>
      {categories.map((category) => (
        <button type="button" data-filter={category}>{category}</button>
      ))}
    </section>

    <section class="writing-width current">
      <div class="section-title"><span>Curated Writing</span></div>
      <div class="post-list">
        {posts.map((post) => (
          <article data-category={post.data.category} data-pinned={post.data.pinned || undefined}>
            <a href={`/writing/${post.id}/`}>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="post-meta">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatContentDate(post.data.publishedAt)}
                </time>
                <span>{post.data.category}</span>
                {post.data.readingMinutes && <span>{post.data.readingMinutes} min</span>}
                {post.data.pinned && <span class="pin-label">置顶</span>}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="writing-width archive section-rule">
      <div class="section-title">
        <span>Early Archive · 2015–2016</span>
      </div>
      <p class="archive-note">早期 iOS 学习与开发记录。保留原貌和旧链接，不与当前文章混排。</p>
      <div class="legacy-list">
        {legacyPosts.map((post) => (
          <a href={`/${post.year}/${post.month}/${post.slug}/`}>
            <time datetime={post.date.toISOString()}>
              {post.date.toISOString().slice(0, 10)}
            </time>
            <span>{post.title}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('[data-filter]');
  const articles = document.querySelectorAll('[data-category]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');
      buttons.forEach((item) => item.classList.toggle('active', item === button));
      articles.forEach((article) => {
        article.toggleAttribute(
          'hidden',
          filter !== 'all' && article.getAttribute('data-category') !== filter,
        );
      });
    });
  });
</script>

<style>
  .writing-background {
    overflow: hidden;
  }

  :global(.space-model.writing-station) {
    position: absolute;
    top: 6vh;
    right: -5vw;
    width: min(34vw, 560px);
    height: 64vh;
    opacity: 0.46;
    mask-image: linear-gradient(90deg, transparent, black 32%);
  }

  .writing-width {
    width: min(calc(100% - 72px), 1120px);
    margin-inline: auto;
  }

  .writing-intro {
    padding-block: 58px 42px;
  }

  .writing-intro h1 {
    margin-top: 14px;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1.08;
  }

  .writing-intro p {
    max-width: 620px;
    margin: 20px 0 0;
    color: var(--ink-dim);
    font-size: 16px;
    line-height: 1.75;
  }

  .filters {
    display: flex;
    gap: 7px;
    padding-block: 15px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .filters button {
    padding: 5px 10px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    color: var(--ink-dim);
    cursor: pointer;
    font-size: 12px;
  }

  .filters button:hover,
  .filters button.active {
    background: var(--ink);
    color: var(--bg);
  }

  .current,
  .archive {
    padding-block: 38px 76px;
  }

  .section-title {
    display: flex;
    margin-bottom: 30px;
    align-items: center;
    gap: 16px;
    color: var(--ink-faint);
    font: 11px var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-title::after {
    height: 1px;
    flex: 1;
    background: var(--line);
    content: "";
  }

  .post-list {
    display: grid;
    gap: 0;
  }

  article {
    border-bottom: 1px solid var(--line);
  }

  article[hidden] {
    display: none;
  }

  article a {
    display: block;
    padding: 28px 0;
    text-decoration: none;
  }

  article h2 {
    margin: 0;
    color: var(--ink);
    font: 400 25px/1.42 var(--serif);
    transition: color 180ms ease;
  }

  article[data-pinned] h2 {
    font-size: 28px;
  }

  article a:hover h2 {
    color: var(--accent);
  }

  article p {
    max-width: 800px;
    margin: 9px 0 0;
    color: var(--ink-dim);
    font-size: 15px;
    line-height: 1.75;
  }

  .post-meta {
    display: flex;
    margin-top: 14px;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--ink-faint);
    font: 11px var(--mono);
  }

  .post-meta span {
    color: var(--accent);
  }

  .pin-label {
    order: -1;
  }

  .archive {
    opacity: 0.72;
  }

  .archive-note {
    margin: -12px 0 28px;
    color: var(--ink-dim);
    font-size: 15px;
  }

  .legacy-list {
    display: grid;
  }

  .legacy-list a {
    display: grid;
    padding: 15px 0;
    grid-template-columns: 112px 1fr;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--ink-dim);
    text-decoration: none;
  }

  .legacy-list a:hover {
    color: var(--ink);
  }

  .legacy-list time {
    color: var(--ink-faint);
    font: 11px var(--mono);
  }

  @media (max-width: 580px) {
    :global(.space-model.writing-station) {
      display: none;
    }

    .writing-width {
      width: min(calc(100% - 36px), 1120px);
    }

    .writing-intro {
      padding-block: 46px 30px;
    }

    .writing-intro h1 {
      font-size: 40px;
    }

    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .filters button {
      flex: 0 0 auto;
    }

    article a {
      padding: 24px 0;
    }

    article[data-pinned] h2 {
      font-size: 25px;
    }

    .legacy-list a {
      gap: 5px;
      grid-template-columns: 1fr;
    }
  }
</style>
