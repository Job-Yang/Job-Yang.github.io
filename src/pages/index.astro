---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHoleBackdrop from '../components/BlackHoleBackdrop.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => {
    const da = a.data.publishedAt?.valueOf();
    const db = b.data.publishedAt?.valueOf();
    if (da != null && db != null && da !== db) return db - da;
    if (da != null && db == null) return -1;
    if (da == null && db != null) return 1;
    return (a.data.order ?? 0) - (b.data.order ?? 0);
  })
  .slice(0, 4);
const renderedNotes = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);
---

<BaseLayout>
  <BlackHoleBackdrop slot="background" />

  <div class="home">
    <section class="hero wide">
      <div class="eyebrow kicker">Engineer · Writer · Builder</div>
      <h1 class="display">清醒时做事，<br />独处时<em>思考</em>。</h1>
      <p>
        我是杨全。曾经写 iOS，现在更多在折腾 <strong>AI Agent 的自演化</strong>——让工具从「会写代码」
        变成「能持续交付」。这里记录文章、手记与长期思考。
      </p>
      <div class="actions">
        <a class="primary" href="/writing/">读文章 →</a>
        <a class="secondary" href="/notes/">看看手记</a>
      </div>
    </section>

    <div class="lower">
      <section class="content-section wide">
        <div class="section-head">
          <h2>最近写的</h2>
          <a class="pill" href="/writing/">全部文章 →</a>
        </div>
        <div class="reading-column cards">
          {posts.map((post) => (
            <a class="card glass" href={`/writing/${post.id}/`}>
              <div class="meta">
                <span>{post.data.category}</span>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toISOString().slice(0, 7)}
                </time>
                {post.data.readingMinutes && <span>{post.data.readingMinutes} min</span>}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      {renderedNotes.length > 0 && (
        <section class="content-section wide">
          <div class="section-head">
            <h2>最近在想</h2>
            <a class="pill" href="/notes/">全部手记 →</a>
          </div>
          <div class="reading-column note-flow">
            {renderedNotes.map(({ note, Content }) => (
              <div class="note-line">
                {note.data.publishedAt ? (
                  <time datetime={note.data.publishedAt.toISOString()}>
                    {note.data.publishedAt.toISOString().slice(0, 10)}
                  </time>
                ) : (
                  <span></span>
                )}
                <div class="note-text"><Content /></div>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="content-section wide">
        <div class="reading-column about">
          <div class="section-head"><h2>关于</h2></div>
          <p>
            iOS 出身的工程师，现在专注 AI Agent 与自演化系统。相信“分享要平视”，文章尽量保留真实过程，
            结论必须有证据。
          </p>
          <a href="/about/">更多关于我与公众号 →</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    position: relative;
    z-index: 2;
  }

  .hero {
    display: flex;
    min-height: calc(100vh - 58px);
    padding-block: 42px;
    flex-direction: column;
    justify-content: center;
  }

  .kicker::before {
    display: inline-block;
    width: 30px;
    height: 1px;
    margin-right: 10px;
    background: var(--accent);
    content: "";
    opacity: 0.6;
    vertical-align: middle;
  }

  .hero h1 {
    max-width: 780px;
    margin: 24px 0 26px;
    font-size: clamp(44px, 6.8vw, 68px);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }

  .hero h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .hero > p {
    max-width: 520px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 18px;
    line-height: 1.75;
  }

  .hero strong {
    color: var(--ink);
    font-weight: 550;
  }

  .actions {
    display: flex;
    gap: 14px;
    margin-top: 38px;
  }

  .actions a {
    display: inline-flex;
    min-height: 46px;
    padding: 0 22px;
    align-items: center;
    border-radius: 11px;
    font-size: 14px;
    text-decoration: none;
  }

  .primary {
    background: var(--ink);
    color: var(--bg);
    font-weight: 650;
  }

  .secondary {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
  }

  .lower {
    background: linear-gradient(180deg, transparent, rgba(3, 3, 3, 0.64) 8%, rgba(3, 3, 3, 0.78));
    backdrop-filter: blur(3px);
  }

  .content-section {
    padding-block: 62px;
    border-top: 1px solid var(--line);
  }

  .section-head {
    display: flex;
    max-width: var(--reading);
    margin-bottom: 30px;
    align-items: center;
    justify-content: space-between;
  }

  .section-head h2 {
    margin: 0;
    font-size: 15px;
  }

  .reading-column {
    max-width: var(--reading);
  }

  .cards {
    display: grid;
    gap: 14px;
  }

  .card,
  .project {
    color: inherit;
    text-decoration: none;
    transition: 220ms ease;
  }

  .card {
    padding: 22px 24px;
    border-radius: 16px;
  }

  .card:hover,
  .project:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.16);
    background: var(--glass-hi);
  }

  .meta {
    display: flex;
    gap: 12px;
    margin-bottom: 9px;
    color: var(--ink-faint);
    font: 12px var(--mono);
  }

  .meta span:first-child {
    color: var(--accent);
  }

  .card h3 {
    margin: 0 0 7px;
    font-size: 18px;
    line-height: 1.4;
  }

  .card p,
  .about p {
    margin: 0;
    color: var(--ink-dim);
  }

  .note-flow {
    display: grid;
    gap: 0;
  }

  .note-line {
    display: grid;
    padding: 18px 0;
    grid-template-columns: 100px 1fr;
    border-bottom: 1px solid var(--line);
  }

  .note-line:last-child {
    border-bottom: none;
  }

  .note-line time {
    color: var(--ink-faint);
    font: 11px var(--mono);
    padding-top: 3px;
  }

  .note-text :global(p) {
    margin: 0;
    color: var(--ink-dim);
    font-size: 15px;
    line-height: 1.7;
  }

  .about > a {
    display: inline-block;
    margin-top: 22px;
    color: var(--accent);
    font-size: 14px;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 78vh;
      justify-content: flex-start;
      padding-top: 13vh;
    }

    .hero h1 {
      font-size: 46px;
    }

    .hero > p {
      max-width: 88%;
      font-size: 16px;
    }
  }
</style>
