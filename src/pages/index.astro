---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHoleBackdrop from '../components/BlackHoleBackdrop.astro';
import ILoopGalaxy from '../components/ILoopGalaxy.astro';
import { formatContentDate } from '../lib/dates';
import { comparePosts } from '../lib/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort(comparePosts)
  .slice(0, 3);
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const featuredSystem = projects.find((project) => project.data.kind === 'system');
const featuredSkills = projects.filter((project) => project.data.kind === 'skill').slice(0, 3);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
      (a.data.title ?? '').localeCompare(b.data.title ?? '', 'zh-CN'),
  )
  .slice(0, 4);

function excerpt(body: string, max = 90): string {
  const text = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*`_\-|]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > max ? text.slice(0, max) + '…' : text;
}

const noteTeasers = notes.map((note) => ({
  note,
  title: note.data.title ?? '',
  excerpt: excerpt(note.body ?? ''),
}));
---

<BaseLayout>
  <BlackHoleBackdrop slot="background" />

  <div class="home">
    <section class="hero wide">
      <div class="eyebrow kicker">Engineer · Writer · Builder</div>
      <h1 class="display">清醒时做事，<br />独处时<em>思考</em>。</h1>
      <p>
        我是老羊。iOS 老兵，最近拥抱 AI，这里记录<span class="no-orphan">一些感想和学习过程。</span>
      </p>
      <div class="actions">
        <a class="primary" href="/writing/">读文章 →</a>
        <a class="secondary" href="/notes/">看看手记</a>
      </div>
    </section>

    <div class="lower">
      <section class="content-section wide" id="selected-work">
        <div class="section-head">
          <h2>系统</h2>
          <a class="pill" href="/projects/">全部沉淀 →</a>
        </div>
        {featuredSystem && (
          <div class="iloop-showcase">
            <div class="iloop-copy">
              <span class="eyebrow">{featuredSystem.data.eyebrow}</span>
              <h3 class="display"><em>i</em>Loop</h3>
              <p class="iloop-statement">
                让 Agent 在真实工程里持续交付。先定义要验证什么，再拿可复核的证据决定是否闭环。
              </p>

              <div class="iloop-capabilities">
                <div>
                  <strong>三档放权</strong>
                  <p>L1 只分析，L2 可以改代码并验证，L3 才会连续执行。</p>
                </div>
                <div>
                  <strong>真实取证</strong>
                  <p>不按固定清单跑工具。按问题选择日志、Crash，或 UI 树、截图与自动化。</p>
                </div>
                <div>
                  <strong>持续病例</strong>
                  <p>保存目标、假设、观测和反证；换一轮仍能据此继续判断。</p>
                </div>
                <div>
                  <strong>独立验收</strong>
                  <p>用证据对照标准；高风险任务交独立 Agent 复核。</p>
                </div>
              </div>

              <a class="iloop-case-link" href="/projects/iloop/#live-trim-case">
                看 AI Agent 怎么解决复杂问题 <span>→</span>
              </a>

              <nav class="iloop-links" aria-label="iLoop 相关内容">
                <a href="/writing/iloop-设计思路/"><em>i</em>Loop 设计</a>
                <a href="/writing/vdd-面向验证的开发/">VDD</a>
                <a href="/writing/oncall-助手/">Oncall</a>
                <a href={featuredSystem.data.github} target="_blank" rel="noreferrer">
                  已开源 · 查看仓库 ↗
                </a>
              </nav>
            </div>
            <ILoopGalaxy />
          </div>
        )}
      </section>

      <section class="content-section wide">
        <div class="section-head">
          <h2>我的技能</h2>
          <a class="pill" href="https://github.com/Job-Yang/jobbyang-ai-skills" target="_blank" rel="noreferrer">
            GitHub 技能仓 ↗
          </a>
        </div>
        <div class="home-skills">
          {featuredSkills.map((project, index) => (
            <a class="home-skill" href={`/projects/${project.id}/`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{project.data.title}</h3>
                <p>{project.data.statement}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="content-section wide">
        <div class="section-head">
          <h2>最近写的</h2>
          <a class="pill" href="/writing/">全部文章 →</a>
        </div>
        <div class="reading-column cards">
          {posts.map((post) => (
            <a class="card glass" href={`/writing/${post.id}/`}>
              <div class="meta">
                <span>{post.data.category}</span>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatContentDate(post.data.publishedAt).slice(0, 7)}
                </time>
                {post.data.readingMinutes && <span>{post.data.readingMinutes} min</span>}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      {noteTeasers.length > 0 && (
        <section class="content-section wide">
          <div class="section-head">
            <h2>最近在想</h2>
            <a class="pill" href="/notes/">全部手记 →</a>
          </div>
          <div class="reading-column note-flow">
            {noteTeasers.map(({ note, title, excerpt }) => (
              <a class="note-line has-date" href="/notes/">
                <time datetime={note.data.publishedAt.toISOString()}>
                  {formatContentDate(note.data.publishedAt)}
                </time>
                <div class="note-text">
                  {title && <strong>{title}</strong>}
                  <span>{excerpt}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="content-section wide">
        <div class="reading-column about">
          <div class="section-head"><h2>关于</h2></div>
          <p>
            资深 iOS 工程师，先后在美团、字节跳动做客户端。最近在全面转向 AI，一边学它、一边用它重做自己的工具。
            这里主要记录：我读到的、想到的、以及踩过的坑。
          </p>
          <a href="/about/">更多关于我与公众号 →</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  // Intercept in-site navigation from the home page and play the black-hole dive
  // before leaving. Only when the WebGL backdrop is available and the user has
  // not asked for reduced motion.
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.addEventListener('click', (event) => {
    if (prefersReduced) return;
    if (event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const link = (event.target as HTMLElement)?.closest?.('a');
    if (!link) return;
    const href = link.getAttribute('href') || '';
    const target = link.getAttribute('target');
    // Only same-origin, in-page-route navigations; skip hashes, downloads, feeds.
    if (
      !href ||
      href.startsWith('#') ||
      href.startsWith('http') ||
      href.startsWith('mailto:') ||
      href.endsWith('.xml') ||
      target === '_blank'
    ) {
      return;
    }

    const dive = (window as any).blackHoleControls?.plunge;
    if (typeof dive !== 'function' || document.body.classList.contains('no-webgpu')) {
      return;
    }

    event.preventDefault();
    // Safety timeout: if the dive can't advance (e.g. backgrounded tab pausing
    // rAF), navigate anyway so a click never appears to hang.
    let navigated = false;
    const go = () => {
      if (navigated) return;
      navigated = true;
      window.location.href = href;
    };
    dive(760).then(go);
    setTimeout(go, 1200);
  });
</script>

<style>
  .home {
    position: relative;
    z-index: 2;
  }

  .home p {
    text-wrap: pretty;
  }

  .hero {
    display: flex;
    min-height: calc(100vh - 58px);
    padding-block: 42px;
    flex-direction: column;
    justify-content: center;
  }

  .kicker::before {
    display: inline-block;
    width: 30px;
    height: 1px;
    margin-right: 10px;
    background: var(--accent);
    content: "";
    opacity: 0.6;
    vertical-align: middle;
  }

  .hero h1 {
    max-width: 780px;
    margin: 24px 0 26px;
    font-size: clamp(44px, 6.8vw, 68px);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }

  .hero h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .hero > p {
    max-width: 580px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 18px;
    line-height: 1.75;
  }

  .no-orphan {
    white-space: nowrap;
  }

  .hero strong {
    color: var(--ink);
    font-weight: 550;
  }

  .actions {
    display: flex;
    gap: 14px;
    margin-top: 38px;
  }

  .actions a {
    display: inline-flex;
    min-height: 46px;
    padding: 0 22px;
    align-items: center;
    border-radius: 11px;
    font-size: 14px;
    text-decoration: none;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .actions a:hover {
    transform: translateY(-2px);
  }

  .actions a:active {
    transform: translateY(0) scale(0.98);
    transition-duration: 90ms;
  }

  .primary {
    background: var(--ink);
    color: var(--bg);
    font-weight: 650;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.4) inset, 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .primary:hover {
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.55) inset, 0 10px 28px rgba(0, 0, 0, 0.45);
  }

  .secondary {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
  }

  .secondary:hover {
    border-color: rgba(245, 185, 113, 0.4);
    background: rgba(255, 255, 255, 0.07);
  }

  .lower {
    background: linear-gradient(180deg, transparent, rgba(3, 3, 3, 0.64) 8%, rgba(3, 3, 3, 0.78));
    backdrop-filter: blur(3px);
  }

  .content-section {
    padding-block: 62px;
    border-top: 1px solid var(--line);
  }

  .section-head {
    display: flex;
    max-width: 1120px;
    margin-bottom: 30px;
    align-items: center;
    justify-content: space-between;
  }

  .section-head h2 {
    margin: 0;
    font-size: 15px;
  }

  .reading-column {
    max-width: 1120px;
  }

  .iloop-showcase {
    display: grid;
    max-width: 1360px;
    padding: 42px clamp(24px, 3.4vw, 48px) 34px;
    grid-template-columns: minmax(340px, 0.78fr) minmax(620px, 1.22fr);
    gap: clamp(38px, 5vw, 82px);
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background:
      linear-gradient(90deg, rgba(3, 3, 3, 0.30), rgba(3, 3, 3, 0.10)),
      rgba(3, 3, 3, 0.04);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(5px) saturate(88%);
  }

  .iloop-copy {
    min-width: 0;
  }

  .iloop-copy > .eyebrow {
    font-size: 10px;
  }

  .iloop-copy h3 {
    margin: 18px 0 20px;
    font-size: clamp(50px, 5vw, 66px);
    line-height: 1;
  }

  .iloop-copy h3 em,
  .iloop-links em {
    color: var(--accent);
    font-style: normal;
  }

  .iloop-statement {
    max-width: 540px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 16px;
    line-height: 1.75;
  }

  .iloop-capabilities {
    display: grid;
    margin-top: 34px;
    gap: 22px;
  }

  .iloop-capabilities strong {
    display: block;
    margin-bottom: 4px;
    color: var(--ink);
    font-size: 15px;
    font-weight: 640;
  }

  .iloop-capabilities p {
    margin: 0;
    color: var(--ink-faint);
    font-size: 13px;
    line-height: 1.6;
  }

  .iloop-case-link {
    display: inline-flex;
    min-height: 44px;
    margin-top: 30px;
    padding: 0 17px;
    align-items: center;
    gap: 20px;
    border: 1px solid rgba(245, 185, 113, 0.4);
    border-radius: 7px;
    background: rgba(245, 185, 113, 0.08);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .iloop-case-link span {
    color: var(--accent);
    transition: transform 180ms ease;
  }

  .iloop-case-link:hover {
    border-color: rgba(245, 185, 113, 0.7);
    background: rgba(245, 185, 113, 0.13);
    transform: translateY(-2px);
  }

  .iloop-case-link:hover span {
    transform: translateX(3px);
  }

  .iloop-links {
    display: flex;
    margin-top: 34px;
    padding-top: 20px;
    flex-wrap: wrap;
    gap: 12px 22px;
    border-top: 1px solid var(--line);
  }

  .iloop-links a {
    color: var(--ink-dim);
    font-size: 13px;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .iloop-links a:hover {
    color: var(--ink);
  }

  .iloop-links a:last-child {
    color: var(--accent);
  }

  .cards {
    display: grid;
    gap: 14px;
  }

  .card,
  .project {
    color: inherit;
    text-decoration: none;
    transition: 220ms ease;
  }

  .card {
    padding: 22px 24px;
    border-radius: 16px;
  }

  .card:hover,
  .project:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.16);
    background: var(--glass-hi);
  }

  .meta {
    display: flex;
    gap: 12px;
    margin-bottom: 9px;
    color: var(--ink-faint);
    font: 12px var(--mono);
  }

  .meta span:first-child {
    color: var(--accent);
  }

  .card h3 {
    margin: 0 0 7px;
    font-size: 18px;
    line-height: 1.4;
  }

  .card p,
  .about p {
    margin: 0;
    color: var(--ink-dim);
  }

  .featured-system {
    max-width: 1120px;
    min-height: 0;
    border-block: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .featured-system:hover {
    opacity: 0.82;
  }

  .featured-system-copy {
    max-width: 760px;
    padding: 54px 20px 58px 0;
  }

  .featured-system-copy > span {
    color: var(--accent);
    font: 10px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-system h3 {
    margin: 12px 0 10px;
    font-family: var(--serif);
    font-size: 56px;
    font-weight: 400;
  }

  .featured-system p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.65;
  }

  .featured-system strong {
    display: inline-block;
    margin-top: 28px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
  }

  .home-skills {
    display: grid;
    max-width: 1120px;
    border-top: 1px solid var(--line);
  }

  .home-skill {
    display: grid;
    padding: 24px 0;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 18px;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .home-skill > span {
    padding-top: 4px;
    color: var(--ink-faint);
    font: 10px var(--mono);
  }

  .home-skill h3 {
    margin: 0 0 7px;
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 400;
  }

  .home-skill p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 14px;
  }

  .home-skill:hover h3 {
    color: var(--accent);
  }

  .note-flow {
    display: grid;
    gap: 0;
  }

  .note-line {
    display: grid;
    padding: 18px 0;
    grid-template-columns: 1fr;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .note-line.has-date {
    grid-template-columns: 100px 1fr;
  }

  .note-line:hover {
    opacity: 0.72;
  }

  .note-line:last-child {
    border-bottom: none;
  }

  .note-line time {
    color: var(--ink-faint);
    font: 11px var(--mono);
    padding-top: 3px;
  }

  .note-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .note-text strong {
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }

  .note-text span {
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 580px) {
    .note-line {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  .about > a {
    display: inline-block;
    margin-top: 22px;
    color: var(--accent);
    font-size: 14px;
    text-decoration: none;
  }

  @media (max-width: 1120px) {
    .iloop-showcase {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .iloop-copy {
      max-width: 720px;
    }
  }

  @media (max-width: 900px) {
    .hero > p {
      max-width: 520px;
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 78vh;
      justify-content: flex-start;
      padding-top: 13vh;
    }

    .hero h1 {
      font-size: 46px;
    }

    .hero > p {
      max-width: 100%;
      font-size: 16px;
    }

    .featured-system-copy {
      padding-block: 38px;
    }

    .iloop-showcase {
      padding: 34px 18px 20px;
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
      border-inline: 0;
      border-radius: 0;
    }

    .iloop-copy h3 {
      font-size: 52px;
    }

    .iloop-capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 18px;
    }
  }

  @media (max-width: 360px) {
    .hero .eyebrow {
      font-size: 10px;
      letter-spacing: 0.12em;
    }

    .hero .kicker::before {
      width: 24px;
      margin-right: 8px;
    }
  }
</style>
