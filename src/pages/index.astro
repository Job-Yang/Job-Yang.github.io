---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHoleBackdrop from '../components/BlackHoleBackdrop.astro';
import ProjectVisual from '../components/ProjectVisual.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => {
    const da = a.data.publishedAt?.valueOf();
    const db = b.data.publishedAt?.valueOf();
    if (da != null && db != null && da !== db) return db - da;
    if (da != null && db == null) return -1;
    if (da == null && db != null) return 1;
    return (a.data.order ?? 0) - (b.data.order ?? 0);
  })
  .slice(0, 4);

function excerpt(body: string, max = 90): string {
  const text = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*`_\-|]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > max ? text.slice(0, max) + '…' : text;
}

const noteTeasers = notes.map((note) => ({
  note,
  title: note.data.title ?? '',
  excerpt: excerpt(note.body ?? ''),
}));
---

<BaseLayout>
  <BlackHoleBackdrop slot="background" />

  <div class="home">
    <section class="hero wide">
      <div class="eyebrow kicker">Engineer · Writer · Builder</div>
      <h1 class="display">清醒时做事，<br />独处时<em>思考</em>。</h1>
      <p>
        我是老羊。iOS 老兵，最近拥抱 AI，这里记录一些感想和学习过程。
      </p>
      <div class="actions">
        <a class="primary" href="/writing/">读文章 →</a>
        <a class="secondary" href="/notes/">看看手记</a>
      </div>
    </section>

    <div class="lower">
      <section class="content-section wide" id="selected-work">
        <div class="section-head">
          <h2>沉淀</h2>
          <a class="pill" href="/projects/">全部沉淀 →</a>
        </div>
        <div class="featured-projects">
          {projects.map((project, index) => (
            <a class="featured-project" href={`/projects/${project.id}/`}>
              <div class="featured-project-copy">
                <span>{String(index + 1).padStart(2, '0')} · {project.data.eyebrow}</span>
                <h3>{project.data.title}</h3>
                <p>{project.data.statement}</p>
              </div>
              <ProjectVisual type={project.data.visual} compact />
            </a>
          ))}
        </div>
      </section>

      <section class="content-section wide">
        <div class="section-head">
          <h2>最近写的</h2>
          <a class="pill" href="/writing/">全部文章 →</a>
        </div>
        <div class="reading-column cards">
          {posts.map((post) => (
            <a class="card glass" href={`/writing/${post.id}/`}>
              <div class="meta">
                <span>{post.data.category}</span>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toISOString().slice(0, 7)}
                </time>
                {post.data.readingMinutes && <span>{post.data.readingMinutes} min</span>}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      {noteTeasers.length > 0 && (
        <section class="content-section wide">
          <div class="section-head">
            <h2>最近在想</h2>
            <a class="pill" href="/notes/">全部手记 →</a>
          </div>
          <div class="reading-column note-flow">
            {noteTeasers.map(({ note, title, excerpt }) => (
              <a class:list={['note-line', { 'has-date': note.data.publishedAt }]} href="/notes/">
                {note.data.publishedAt ? (
                  <time datetime={note.data.publishedAt.toISOString()}>
                    {note.data.publishedAt.toISOString().slice(0, 10)}
                  </time>
                ) : null}
                <div class="note-text">
                  {title && <strong>{title}</strong>}
                  <span>{excerpt}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="content-section wide">
        <div class="reading-column about">
          <div class="section-head"><h2>关于</h2></div>
          <p>
            资深 iOS 工程师，先后在美团、字节跳动做客户端。最近在全面转向 AI，一边学它、一边用它重做自己的工具。
            这里主要记录：我读到的、想到的、以及踩过的坑。
          </p>
          <a href="/about/">更多关于我与公众号 →</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  // Intercept in-site navigation from the home page and play the black-hole dive
  // before leaving. Only when the WebGL backdrop is available and the user has
  // not asked for reduced motion.
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.addEventListener('click', (event) => {
    if (prefersReduced) return;
    if (event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const link = (event.target as HTMLElement)?.closest?.('a');
    if (!link) return;
    const href = link.getAttribute('href') || '';
    const target = link.getAttribute('target');
    // Only same-origin, in-page-route navigations; skip hashes, downloads, feeds.
    if (
      !href ||
      href.startsWith('#') ||
      href.startsWith('http') ||
      href.startsWith('mailto:') ||
      href.endsWith('.xml') ||
      target === '_blank'
    ) {
      return;
    }

    const dive = (window as any).blackHoleControls?.plunge;
    if (typeof dive !== 'function' || document.body.classList.contains('no-webgpu')) {
      return;
    }

    event.preventDefault();
    // Safety timeout: if the dive can't advance (e.g. backgrounded tab pausing
    // rAF), navigate anyway so a click never appears to hang.
    let navigated = false;
    const go = () => {
      if (navigated) return;
      navigated = true;
      window.location.href = href;
    };
    dive(760).then(go);
    setTimeout(go, 1200);
  });
</script>

<style>
  .home {
    position: relative;
    z-index: 2;
  }

  .hero {
    display: flex;
    min-height: calc(100vh - 58px);
    padding-block: 42px;
    flex-direction: column;
    justify-content: center;
  }

  .kicker::before {
    display: inline-block;
    width: 30px;
    height: 1px;
    margin-right: 10px;
    background: var(--accent);
    content: "";
    opacity: 0.6;
    vertical-align: middle;
  }

  .hero h1 {
    max-width: 780px;
    margin: 24px 0 26px;
    font-size: clamp(44px, 6.8vw, 68px);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }

  .hero h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .hero > p {
    max-width: 520px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 18px;
    line-height: 1.75;
  }

  .hero strong {
    color: var(--ink);
    font-weight: 550;
  }

  .actions {
    display: flex;
    gap: 14px;
    margin-top: 38px;
  }

  .actions a {
    display: inline-flex;
    min-height: 46px;
    padding: 0 22px;
    align-items: center;
    border-radius: 11px;
    font-size: 14px;
    text-decoration: none;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .actions a:hover {
    transform: translateY(-2px);
  }

  .actions a:active {
    transform: translateY(0) scale(0.98);
    transition-duration: 90ms;
  }

  .primary {
    background: var(--ink);
    color: var(--bg);
    font-weight: 650;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.4) inset, 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .primary:hover {
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.55) inset, 0 10px 28px rgba(0, 0, 0, 0.45);
  }

  .secondary {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
  }

  .secondary:hover {
    border-color: rgba(245, 185, 113, 0.4);
    background: rgba(255, 255, 255, 0.07);
  }

  .lower {
    background: linear-gradient(180deg, transparent, rgba(3, 3, 3, 0.64) 8%, rgba(3, 3, 3, 0.78));
    backdrop-filter: blur(3px);
  }

  .content-section {
    padding-block: 62px;
    border-top: 1px solid var(--line);
  }

  .section-head {
    display: flex;
    max-width: 1120px;
    margin-bottom: 30px;
    align-items: center;
    justify-content: space-between;
  }

  .section-head h2 {
    margin: 0;
    font-size: 15px;
  }

  .reading-column {
    max-width: 1120px;
  }

  .cards {
    display: grid;
    gap: 14px;
  }

  .card,
  .project {
    color: inherit;
    text-decoration: none;
    transition: 220ms ease;
  }

  .card {
    padding: 22px 24px;
    border-radius: 16px;
  }

  .card:hover,
  .project:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.16);
    background: var(--glass-hi);
  }

  .meta {
    display: flex;
    gap: 12px;
    margin-bottom: 9px;
    color: var(--ink-faint);
    font: 12px var(--mono);
  }

  .meta span:first-child {
    color: var(--accent);
  }

  .card h3 {
    margin: 0 0 7px;
    font-size: 18px;
    line-height: 1.4;
  }

  .card p,
  .about p {
    margin: 0;
    color: var(--ink-dim);
  }

  .featured-projects {
    display: grid;
    max-width: 1120px;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .featured-project {
    display: grid;
    min-height: 290px;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .featured-project:hover {
    opacity: 0.82;
  }

  .featured-project :global(.project-visual) {
    height: 270px;
  }

  .featured-project-copy {
    padding: 34px 20px 34px 0;
  }

  .featured-project-copy > span {
    color: var(--accent);
    font: 10px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-project h3 {
    margin: 12px 0 10px;
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 400;
  }

  .featured-project p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.65;
  }

  .note-flow {
    display: grid;
    gap: 0;
  }

  .note-line {
    display: grid;
    padding: 18px 0;
    grid-template-columns: 1fr;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .note-line.has-date {
    grid-template-columns: 100px 1fr;
  }

  .note-line:hover {
    opacity: 0.72;
  }

  .note-line:last-child {
    border-bottom: none;
  }

  .note-line time {
    color: var(--ink-faint);
    font: 11px var(--mono);
    padding-top: 3px;
  }

  .note-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .note-text strong {
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }

  .note-text span {
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 580px) {
    .note-line {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  .about > a {
    display: inline-block;
    margin-top: 22px;
    color: var(--accent);
    font-size: 14px;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 78vh;
      justify-content: flex-start;
      padding-top: 13vh;
    }

    .hero h1 {
      font-size: 46px;
    }

    .hero > p {
      max-width: 88%;
      font-size: 16px;
    }

    .featured-projects {
      gap: 0;
    }

    .featured-project {
      padding-block: 34px;
      grid-template-columns: 1fr;
    }

    .featured-project-copy {
      padding: 0;
    }

    .featured-project :global(.project-visual) {
      height: auto;
      aspect-ratio: 3 / 2;
    }
  }
</style>
