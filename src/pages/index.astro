---
import { getCollection } from 'astro:content';
import ActivityFeed from '../components/ActivityFeed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHoleBackdrop from '../components/BlackHoleBackdrop.astro';
import ILoopGalaxy from '../components/ILoopGalaxy.astro';
import LearningSpotlight from '../components/learning/LearningSpotlight.astro';
import { formatContentDate } from '../lib/dates';
import { comparePosts } from '../lib/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort(comparePosts)
  .slice(0, 3);
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const featuredSystem = projects.find((project) => project.data.kind === 'system');
const featuredSkills = projects.filter((project) => project.data.kind === 'skill').slice(0, 3);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
      (a.data.title ?? '').localeCompare(b.data.title ?? '', 'zh-CN'),
  )
  .slice(0, 4);

function excerpt(body: string, max = 90): string {
  const text = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*`_\-|]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > max ? text.slice(0, max) + '…' : text;
}

const noteTeasers = notes.map((note) => ({
  note,
  title: note.data.title ?? '',
  excerpt: excerpt(note.body ?? ''),
}));
---

<BaseLayout>
  <BlackHoleBackdrop slot="background" />

  <div class="home">
    <section class="hero wide">
      <div class="eyebrow kicker">Engineer · Writer · Builder</div>
      <h1 class="display">清醒时做事，<br />独处时<em>思考</em>。</h1>
      <p>
        我是老羊。iOS 老兵，最近拥抱 AI，这里记录<span class="no-orphan">一些感想和学习过程。</span>
      </p>
      <div class="actions">
        <a class="primary" href="/writing/">读文章 →</a>
        <a class="secondary" href="/notes/">看看手记</a>
      </div>
      <a class="hero-scroll-cue" href="#live-work">
        <span>NOW · 正在发生</span>
        <b aria-hidden="true">↓</b>
      </a>
    </section>

    <div class="lower">
      <section class="content-section wide now-section" id="live-work">
        <ActivityFeed mode="compact" limit={4} />
      </section>

      <section class="content-section feature-section wide" id="learning">
        <LearningSpotlight compact />
      </section>

      <section class="content-section feature-section wide" id="selected-work">
        {featuredSystem && (
          <div class="iloop-showcase">
            <div class="iloop-copy">
              <div class="section-head feature-head">
                <h2>系统</h2>
                <a class="pill" href="/projects/">全部沉淀 →</a>
              </div>
              <span class="eyebrow">{featuredSystem.data.eyebrow}</span>
              <h3 class="display"><em>i</em>Loop</h3>
              <p class="iloop-statement">
                让 Agent 在真实工程里持续交付。先定义要验证什么，再拿可复核的证据决定是否闭环。
              </p>

              <div class="feature-actions">
                <a class="feature-primary" href="/projects/iloop/#live-trim-case">
                  看复杂任务回放 <span>→</span>
                </a>
                <a class="feature-secondary" href={featuredSystem.data.github} target="_blank" rel="noreferrer">
                  查看开源仓库 ↗
                </a>
              </div>

              <nav class="iloop-links" aria-label="iLoop 相关内容">
                <a href="/writing/iloop-设计思路/"><em>i</em>Loop 设计</a>
                <a href="/writing/vdd-面向验证的开发/">VDD</a>
                <a href="/writing/oncall-助手/">Oncall</a>
                <span>L1/L2/L3 分级放权</span>
                <span>真实取证</span>
                <span>独立验收</span>
              </nav>
            </div>
            <ILoopGalaxy />
          </div>
        )}
      </section>

      <section class="content-section wide">
        <div class="section-head">
          <h2>我的技能</h2>
          <a class="pill" href="https://github.com/Job-Yang/jobbyang-ai-skills" target="_blank" rel="noreferrer">
            GitHub 技能仓 ↗
          </a>
        </div>
        <div class="home-list home-skills">
          {featuredSkills.map((project, index) => (
            <a class="home-row home-skill" href={`/projects/${project.id}/`}>
              <div class="home-row-meta">{String(index + 1).padStart(2, '0')}</div>
              <div class="home-row-copy">
                <h3>{project.data.title}</h3>
                <p>{project.data.statement}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="content-section wide">
        <div class="section-head">
          <h2>最近写的</h2>
          <a class="pill" href="/writing/">全部文章 →</a>
        </div>
        <div class="home-list reading-column">
          {posts.map((post) => (
            <a class="home-row post-line" href={`/writing/${post.id}/`}>
              <div class="home-row-meta">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatContentDate(post.data.publishedAt)}
                </time>
                <span>{post.data.category}</span>
                {post.data.readingMinutes && <span>{post.data.readingMinutes} min</span>}
              </div>
              <div class="home-row-copy">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      {noteTeasers.length > 0 && (
        <section class="content-section wide">
          <div class="section-head">
            <h2>最近在想</h2>
            <a class="pill" href="/notes/">全部手记 →</a>
          </div>
          <div class="home-list reading-column note-flow">
            {noteTeasers.map(({ note, title, excerpt }) => (
              <a class="home-row note-line" href="/notes/">
                <div class="home-row-meta">
                  <time datetime={note.data.publishedAt.toISOString()}>
                    {formatContentDate(note.data.publishedAt)}
                  </time>
                </div>
                <div class="home-row-copy">
                  {title && <h3>{title}</h3>}
                  <p>{excerpt}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="content-section wide">
        <div class="reading-column about">
          <div class="section-head"><h2>关于</h2></div>
          <p>
            资深 iOS 工程师，先后在美团、字节跳动做客户端。最近在全面转向 AI，一边学它、一边用它重做自己的工具。
            这里主要记录：我读到的、想到的、以及踩过的坑。
          </p>
          <a href="/about/">更多关于我 →</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  // Intercept in-site navigation from the home page and play the black-hole dive
  // before leaving. Only when the WebGL backdrop is available and the user has
  // not asked for reduced motion.
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.addEventListener('click', (event) => {
    if (prefersReduced) return;
    if (event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const link = (event.target as HTMLElement)?.closest?.('a');
    if (!link) return;
    const href = link.getAttribute('href') || '';
    const target = link.getAttribute('target');
    // Only same-origin, in-page-route navigations; skip hashes, downloads, feeds.
    if (
      !href ||
      href.startsWith('#') ||
      href.startsWith('http') ||
      href.startsWith('mailto:') ||
      href.endsWith('.xml') ||
      target === '_blank'
    ) {
      return;
    }

    const dive = (window as any).blackHoleControls?.plunge;
    if (typeof dive !== 'function' || document.body.classList.contains('no-webgpu')) {
      return;
    }

    event.preventDefault();
    // Safety timeout: if the dive can't advance (e.g. backgrounded tab pausing
    // rAF), navigate anyway so a click never appears to hang.
    let navigated = false;
    const go = () => {
      if (navigated) return;
      navigated = true;
      window.location.href = href;
    };
    dive(760).then(go);
    setTimeout(go, 1200);
  });
</script>

<style>
  .home {
    position: relative;
    z-index: 2;
  }

  .home p {
    text-wrap: pretty;
  }

  .home :global(.pill) {
    min-height: 40px;
    padding-inline: 17px;
    font-size: 15px;
  }

  .hero {
    position: relative;
    display: flex;
    min-height: calc(100svh - 52px);
    padding: 42px 0 82px;
    flex-direction: column;
    justify-content: center;
  }

  .kicker::before {
    display: inline-block;
    width: 30px;
    height: 1px;
    margin-right: 10px;
    background: var(--accent);
    content: "";
    opacity: 0.6;
    vertical-align: middle;
  }

  .hero h1 {
    max-width: 780px;
    margin: 24px 0 26px;
    font-size: clamp(44px, 6.8vw, 68px);
    line-height: 1.06;
    letter-spacing: 0;
  }

  .hero h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .hero > p {
    max-width: 580px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 18px;
    line-height: 1.75;
  }

  .no-orphan {
    white-space: nowrap;
  }

  .hero strong {
    color: var(--ink);
    font-weight: 550;
  }

  .actions {
    display: flex;
    gap: 14px;
    margin-top: 38px;
  }

  .actions a {
    display: inline-flex;
    min-height: 46px;
    padding: 0 22px;
    align-items: center;
    border-radius: 11px;
    font-size: 16px;
    text-decoration: none;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .actions a:hover {
    transform: translateY(-2px);
  }

  .actions a:active {
    transform: translateY(0) scale(0.98);
    transition-duration: 90ms;
  }

  .primary {
    background: var(--ink);
    color: var(--bg);
    font-weight: 650;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.4) inset, 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .primary:hover {
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.55) inset, 0 10px 28px rgba(0, 0, 0, 0.45);
  }

  .secondary {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
  }

  .secondary:hover {
    border-color: rgba(245, 185, 113, 0.4);
    background: rgba(255, 255, 255, 0.07);
  }

  .hero-scroll-cue {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    color: var(--ink-faint);
    font: 11px var(--mono);
    text-decoration: none;
  }

  .hero-scroll-cue b {
    color: var(--ink);
    font-size: 17px;
    font-weight: 400;
    animation: home-scroll-cue 1.8s ease-in-out infinite;
  }

  .hero-scroll-cue:hover {
    color: var(--accent);
  }

  @keyframes home-scroll-cue {
    50% {
      transform: translateY(5px);
    }
  }

  .lower {
    background: transparent;
  }

  .content-section {
    position: relative;
    padding-block: clamp(54px, 6vw, 84px);
    isolation: isolate;
  }

  .content-section + .content-section {
    margin-top: clamp(26px, 4vw, 58px);
  }

  .content-section::before {
    position: absolute;
    top: 0;
    bottom: -24px;
    left: 50%;
    z-index: -1;
    width: 100vw;
    background: linear-gradient(
      90deg,
      rgba(3, 3, 3, 0.48) 0%,
      rgba(3, 3, 3, 0.32) 58%,
      rgba(3, 3, 3, 0.22) 100%
    );
    content: "";
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.72) 28%,
      #000 calc(100% - 24px),
      transparent 100%
    );
    pointer-events: none;
    transform: translateX(-50%);
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.72) 28%,
      #000 calc(100% - 24px),
      transparent 100%
    );
  }

  .feature-section {
    padding-block: 22px;
  }

  .now-section {
    padding-block: 64px 74px;
  }

  .section-head {
    display: flex;
    max-width: 1120px;
    margin-bottom: 24px;
    align-items: center;
    justify-content: space-between;
  }

  .section-head h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .reading-column {
    max-width: 1120px;
  }

  .iloop-showcase {
    display: grid;
    max-width: 1360px;
    padding-block: 18px 36px;
    grid-template-columns: minmax(340px, 0.72fr) minmax(600px, 1.28fr);
    gap: clamp(44px, 7vw, 100px);
    align-items: center;
  }

  .iloop-copy {
    min-width: 0;
  }

  .feature-head {
    margin-bottom: 34px;
  }

  .iloop-copy > .eyebrow {
    font-size: 11px;
  }

  .iloop-copy h3 {
    margin: 18px 0 20px;
    font-size: clamp(50px, 5vw, 66px);
    line-height: 1;
  }

  .iloop-copy h3 em,
  .iloop-links em {
    color: var(--accent);
    font-style: normal;
  }

  .iloop-statement {
    max-width: 540px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 17px;
    line-height: 1.65;
  }

  .feature-actions {
    display: flex;
    margin-top: 28px;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .feature-actions a {
    display: inline-flex;
    min-height: 42px;
    padding: 0 14px;
    align-items: center;
    gap: 16px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .feature-primary {
    border-color: rgba(245, 185, 113, 0.46) !important;
    color: var(--accent) !important;
  }

  .feature-actions span {
    color: var(--accent);
    transition: transform 180ms ease;
  }

  .feature-actions a:hover {
    border-color: rgba(245, 185, 113, 0.7);
    background: rgba(245, 185, 113, 0.06);
    transform: translateY(-2px);
  }

  .feature-actions a:hover span {
    transform: translateX(3px);
  }

  .iloop-links {
    display: flex;
    margin-top: 34px;
    flex-wrap: wrap;
    gap: 12px 22px;
  }

  .iloop-links a {
    color: var(--ink-dim);
    font-size: 14px;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .iloop-links span {
    color: var(--ink-faint);
    font: 11px var(--mono);
  }

  .iloop-links a:hover {
    color: var(--ink);
  }

  .home-list {
    display: grid;
    max-width: 1120px;
  }

  .home-row {
    display: grid;
    padding: 22px 0;
    grid-template-columns: 142px minmax(0, 1fr);
    gap: 26px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.055);
    color: inherit;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .home-row:hover {
    opacity: 0.74;
  }

  .home-row-meta {
    display: grid;
    align-content: start;
    gap: 5px;
    padding-top: 3px;
    color: var(--ink-faint);
    font: 11px var(--mono);
  }

  .home-row-meta span:first-of-type {
    color: var(--accent);
  }

  .home-row-copy {
    display: grid;
    grid-template-columns: minmax(210px, 310px) minmax(0, 1fr);
    align-items: start;
    gap: 28px;
  }

  .home-row h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 25px;
    line-height: 1.35;
    font-weight: 400;
  }

  .home-row p {
    margin: 2px 0 0;
    color: var(--ink-dim);
    font-size: 16px;
    line-height: 1.6;
  }

  .home-skill:hover h3 {
    color: var(--accent);
  }

  .about p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 17px;
    line-height: 1.65;
  }

  .now-section :global(.activity-feed) {
    max-width: 1120px;
  }

  .about > a {
    display: inline-block;
    margin-top: 22px;
    color: var(--accent);
    font-size: 15px;
    text-decoration: none;
  }

  @media (max-width: 1000px) {
    .iloop-showcase {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .iloop-copy {
      max-width: 720px;
    }
  }

  @media (max-width: 900px) {
    .hero > p {
      max-width: 520px;
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: calc(100svh - 52px);
      justify-content: flex-start;
      padding: 11vh 0 76px;
    }

    .hero h1 {
      font-size: 46px;
    }

    .hero > p {
      max-width: 100%;
      font-size: 17px;
    }

    .section-head {
      padding-right: 86px;
    }

    .iloop-showcase {
      min-height: 0;
      padding-block: 44px;
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .iloop-copy h3 {
      font-size: 52px;
    }

    .home-row {
      grid-template-columns: 1fr;
      gap: 9px;
    }

    .home-row-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px 12px;
    }

    .home-row-copy {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  @media (max-width: 360px) {
    .hero .eyebrow {
      font-size: 10px;
      letter-spacing: 0.12em;
    }

    .hero .kicker::before {
      width: 24px;
      margin-right: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-cue b {
      animation: none;
    }
  }
</style>
