---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedbackLoopDiagram from '../../components/FeedbackLoopDiagram.astro';
import SpaceModel from '../../components/SpaceModel.astro';
import { formatContentDate } from '../../lib/dates';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
    (a.data.title ?? '').localeCompare(b.data.title ?? '', 'zh-CN'),
);
const rendered = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);
const hasMermaid = notes.some((note) => note.body?.includes('```mermaid'));
---

<BaseLayout
  title="手记"
  description="短想法、片段和正在成形的念头。"
  active="notes"
>
  <div class="space-fallback notes-background" slot="background">
    <SpaceModel model="probe" class="notes-probe" />
  </div>
  <div class="page-shell">
    <header class="page-intro reading">
      <div class="eyebrow">Forge Notes</div>
      <h1 class="display">手记<span>。</span></h1>
      <p>还没长成文章的想法，先记在这里。短的一句，长的一段，都是过程。</p>
    </header>

    <section class="reading notes-feed">
      {rendered.length === 0 && <p class="empty">还没有公开的手记。</p>}
      {rendered.map(({ note, Content }) => (
        <article class="note-card">
          <time datetime={note.data.publishedAt.toISOString()}>
            {formatContentDate(note.data.publishedAt)}
          </time>
          <div class="note-content">
            {note.data.title && <h2>{note.data.title}</h2>}
            <Content />
            {note.id === '反馈循环' && <FeedbackLoopDiagram />}
          </div>
          {note.data.tags.length > 0 && (
            <div class="tags">
              {note.data.tags.map((tag) => <span>#{tag}</span>)}
            </div>
          )}
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

{hasMermaid && (
  <script>
    import mermaid from 'mermaid';

    function renderMermaid() {
      const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
      if (!blocks.length) return;
      mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'loose' });
      blocks.forEach((pre) => {
        const holder = document.createElement('div');
        holder.className = 'mermaid';
        holder.textContent = pre.textContent ?? '';
        pre.replaceWith(holder);
      });
      mermaid.run({ querySelector: '.mermaid' }).catch((err) => console.error('[mermaid]', err));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaid);
    } else {
      renderMermaid();
    }
  </script>
)}

<style>
  .notes-background {
    overflow: hidden;
  }

  :global(.space-model.notes-probe) {
    position: absolute;
    top: 4vh;
    right: -5vw;
    width: min(43vw, 680px);
    height: min(70vh, 680px);
    opacity: 0.5;
    mask-image: linear-gradient(90deg, transparent, black 30%);
  }

  .notes-feed {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-block: 44px 90px;
  }

  .empty {
    color: var(--ink-faint);
    font-size: 15px;
  }

  .note-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    padding: 25px 27px 26px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 24px;
    background:
      linear-gradient(
        142deg,
        rgba(255, 255, 255, 0.065) 0%,
        rgba(255, 255, 255, 0.027) 42%,
        rgba(12, 12, 12, 0.7) 100%
      ),
      rgba(8, 8, 8, 0.82);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      inset 0 -1px 0 rgba(245, 185, 113, 0.035),
      0 16px 36px rgba(0, 0, 0, 0.34),
      0 2px 8px rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(14px) saturate(112%);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      transform 200ms ease;
  }

  .note-card::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background:
      linear-gradient(
        105deg,
        rgba(255, 255, 255, 0.075),
        transparent 24%,
        transparent 78%,
        rgba(245, 185, 113, 0.035)
      );
    content: "";
    pointer-events: none;
  }

  .note-card::after {
    position: absolute;
    top: 0;
    left: 9%;
    width: 42%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.36),
      transparent
    );
    content: "";
    pointer-events: none;
  }

  .note-card:hover {
    border-color: rgba(245, 185, 113, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.11),
      inset 0 -1px 0 rgba(245, 185, 113, 0.055),
      0 20px 44px rgba(0, 0, 0, 0.4),
      0 3px 10px rgba(0, 0, 0, 0.28);
    transform: translateY(-2px);
  }

  .note-card time {
    display: block;
    margin-bottom: 12px;
    color: var(--ink-faint);
    font: 11px var(--mono);
  }

  .note-content h2 {
    margin: 0 0 12px;
    color: var(--ink);
    font-size: 18px;
    line-height: 1.45;
  }

  .note-content :global(p) {
    margin: 0 0 12px;
    color: var(--ink-dim);
    font-size: 15.5px;
    line-height: 1.75;
  }

  .note-content :global(*:last-child) {
    margin-bottom: 0;
  }

  .note-content :global(ul),
  .note-content :global(ol) {
    margin: 0 0 12px;
    padding-left: 1.3em;
    color: var(--ink-dim);
    font-size: 15.5px;
    line-height: 1.75;
  }

  .note-content :global(li) {
    margin-bottom: 6px;
  }

  .note-content :global(li::marker) {
    color: var(--ink-faint);
  }

  .note-content :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .note-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(224, 122, 45, 0.4);
    word-break: break-all;
  }

  .note-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .note-content :global(blockquote) {
    margin: 0 0 12px;
    padding: 4px 0 4px 16px;
    border-left: 2px solid var(--line);
    color: var(--ink-dim);
  }

  .note-content :global(code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    font: 13px var(--mono);
  }

  .note-content :global(pre) {
    margin: 0 0 12px;
    padding: 16px 18px;
    overflow-x: auto;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--line);
  }

  .note-content :global(pre code) {
    padding: 0;
    background: none;
    font-size: 12.5px;
    line-height: 1.6;
  }

  .note-content :global(.mermaid) {
    margin: 0 0 12px;
    display: flex;
    justify-content: center;
  }

  .note-content :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }

  .note-content :global(img) {
    max-width: 100%;
    border-radius: 10px;
  }

  .tags {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .tags span {
    color: var(--accent);
    font: 12px var(--mono);
  }

  @media (max-width: 720px) {
    :global(.space-model.notes-probe) {
      top: 2vh;
      right: -34vw;
      width: 96vw;
      height: 54vh;
      opacity: 0.3;
    }

    .notes-feed {
      gap: 16px;
      padding-top: 34px;
    }

    .note-card {
      padding: 21px 22px 22px;
      border-radius: 20px;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.085),
        inset 0 -1px 0 rgba(245, 185, 113, 0.03),
        0 12px 26px rgba(0, 0, 0, 0.32);
    }

  }
</style>
