---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => {
  const da = a.data.publishedAt?.valueOf();
  const db = b.data.publishedAt?.valueOf();
  if (da != null && db != null && da !== db) return db - da;
  if (da != null && db == null) return -1;
  if (da == null && db != null) return 1;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});
const rendered = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);
const hasMermaid = notes.some((note) => note.body?.includes('```mermaid'));
---

<BaseLayout
  title="手记"
  description="短想法、片段和正在成形的念头。"
  active="notes"
>
  <div class="space-fallback" slot="background"></div>
  <div class="page-shell">
    <header class="page-intro reading">
      <div class="eyebrow">Forge Notes</div>
      <h1 class="display">手记<span>。</span></h1>
      <p>还没长成文章的想法，先记在这里。短的一句，长的一段，都是过程。</p>
    </header>

    <section class="reading notes-feed">
      {rendered.length === 0 && <p class="empty">还没有公开的手记。</p>}
      {rendered.map(({ note, Content }) => (
        <article class="note-card">
          {note.data.publishedAt && (
            <time datetime={note.data.publishedAt.toISOString()}>
              {note.data.publishedAt.toISOString().slice(0, 10)}
            </time>
          )}
          <div class="note-content">
            {note.data.title && <h2>{note.data.title}</h2>}
            <Content />
          </div>
          {note.data.tags.length > 0 && (
            <div class="tags">
              {note.data.tags.map((tag) => <span>#{tag}</span>)}
            </div>
          )}
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

{hasMermaid && (
  <script>
    import mermaid from 'mermaid';

    function renderMermaid() {
      const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
      if (!blocks.length) return;
      mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'loose' });
      blocks.forEach((pre) => {
        const holder = document.createElement('div');
        holder.className = 'mermaid';
        holder.textContent = pre.textContent ?? '';
        pre.replaceWith(holder);
      });
      mermaid.run({ querySelector: '.mermaid' }).catch((err) => console.error('[mermaid]', err));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaid);
    } else {
      renderMermaid();
    }
  </script>
)}

<style>
  .notes-feed {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: 44px 90px;
  }

  .empty {
    color: var(--ink-faint);
    font-size: 15px;
  }

  .note-card {
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.035);
    backdrop-filter: blur(8px);
    transition: border-color 200ms ease, background 200ms ease;
  }

  .note-card:hover {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.055);
  }

  .note-card time {
    display: block;
    margin-bottom: 12px;
    color: var(--ink-faint);
    font: 11px var(--mono);
  }

  .note-content h2 {
    margin: 0 0 12px;
    color: var(--ink);
    font-size: 18px;
    line-height: 1.45;
  }

  .note-content :global(p) {
    margin: 0 0 12px;
    color: var(--ink-dim);
    font-size: 15.5px;
    line-height: 1.75;
  }

  .note-content :global(*:last-child) {
    margin-bottom: 0;
  }

  .note-content :global(ul),
  .note-content :global(ol) {
    margin: 0 0 12px;
    padding-left: 1.3em;
    color: var(--ink-dim);
    font-size: 15.5px;
    line-height: 1.75;
  }

  .note-content :global(li) {
    margin-bottom: 6px;
  }

  .note-content :global(li::marker) {
    color: var(--ink-faint);
  }

  .note-content :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .note-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(224, 122, 45, 0.4);
    word-break: break-all;
  }

  .note-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .note-content :global(blockquote) {
    margin: 0 0 12px;
    padding: 4px 0 4px 16px;
    border-left: 2px solid var(--line);
    color: var(--ink-dim);
  }

  .note-content :global(code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    font: 13px var(--mono);
  }

  .note-content :global(pre) {
    margin: 0 0 12px;
    padding: 16px 18px;
    overflow-x: auto;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--line);
  }

  .note-content :global(pre code) {
    padding: 0;
    background: none;
    font-size: 12.5px;
    line-height: 1.6;
  }

  .note-content :global(.mermaid) {
    margin: 0 0 12px;
    display: flex;
    justify-content: center;
  }

  .note-content :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }

  .note-content :global(img) {
    max-width: 100%;
    border-radius: 10px;
  }

  .tags {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .tags span {
    color: var(--accent);
    font: 12px var(--mono);
  }
</style>
