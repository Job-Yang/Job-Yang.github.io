---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ILoopGalaxy from '../../components/ILoopGalaxy.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const systems = projects.filter((project) => project.data.kind === 'system');
const skills = projects.filter((project) => project.data.kind === 'skill');
const experiments = projects.filter((project) => project.data.kind === 'experiment');
const skillRepository = 'https://github.com/Job-Yang/jobbyang-ai-skills';
---

<BaseLayout
  title="沉淀"
  description="从方法论、系统到可安装技能：把反复有用的经验做成真正能运行的东西。"
  active="projects"
>
  <div class="space-fallback" slot="background"></div>
  <div class="projects-page">
    <header class="projects-intro wide">
      <div class="eyebrow">Systems · Skills · Experiments</div>
      <h1 class="display">沉淀</h1>
      <p>有些想法写成文章，有些继续往前，最后变成系统、技能和可以运行的实验。</p>
    </header>

    {systems.length > 0 && (
      <section class="portfolio-band system-band">
        <div class="band-head wide">
          <div>
            <span class="section-index">01</span>
            <div class="eyebrow">系统</div>
          </div>
          <p>解决一类长期问题的完整工程，不是单次调用的工具。</p>
        </div>
        <div class="system-list wide">
          {systems.map((project) => (
            <article class:list={['system-feature', { 'system-feature-iloop': project.id === 'iloop' }]}>
              <div class="system-copy">
                <span class="status">{project.data.status}</span>
                <h2 class="display">
                  {project.id === 'iloop' ? <><em>i</em>Loop</> : project.data.title}
                </h2>
                <p>{project.data.statement}</p>
                <div class="project-tags">
                  {project.data.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <a class="system-link" href={`/projects/${project.id}/`}>了解设计与进展 →</a>
              </div>
              {project.id === 'iloop' && (
                <div class="system-galaxy" aria-label="iLoop 验证驱动闭环演示">
                  <ILoopGalaxy />
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {skills.length > 0 && (
      <section class="portfolio-band skills-band">
        <div class="band-head wide">
          <div>
            <span class="section-index">02</span>
            <div class="eyebrow">技能</div>
          </div>
          <div class="band-side">
            <p>把真实任务里反复用到的判断、流程和脚本，做成 Agent 能安装的能力。</p>
            <a href={skillRepository} target="_blank" rel="noreferrer">个人技能仓 ↗</a>
          </div>
        </div>
        <div class="skill-list wide">
          {skills.map((project, index) => (
            <article class="skill-row">
              <a class="skill-main" href={`/projects/${project.id}/`}>
                <span class="skill-index">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <div class="eyebrow">{project.data.eyebrow}</div>
                  <h2 class="display">{project.data.title}</h2>
                  <p>{project.data.statement}</p>
                </div>
              </a>
              <div class="skill-actions">
                <a href={`/projects/${project.id}/`}>为什么做它 →</a>
                {project.data.github && (
                  <a href={project.data.github} target="_blank" rel="noreferrer">源码 ↗</a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {experiments.length > 0 && (
      <section class="portfolio-band experiments-band">
        <div class="band-head wide">
          <div>
            <span class="section-index">03</span>
            <div class="eyebrow">实验</div>
          </div>
          <p>用最小成本把一个想法跑起来，再决定它值不值得继续。</p>
        </div>
        <div class="experiment-list wide">
          {experiments.map((project) => (
            <a href={`/projects/${project.id}/`}>
              <h2>{project.data.title}</h2>
              <p>{project.data.statement}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="projects-future wide">
      <div class="eyebrow">Continuing</div>
      <p>这里会继续长出新的系统、技能和实验。</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .projects-page {
    position: relative;
    z-index: 2;
  }

  .projects-intro {
    padding-block: 86px 94px;
  }

  .projects-intro h1 {
    margin: 16px 0 18px;
    font-size: clamp(54px, 7vw, 82px);
    line-height: 1;
  }

  .projects-intro p {
    max-width: 680px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 18px;
    line-height: 1.8;
  }

  .portfolio-band {
    padding-block: 76px 92px;
    border-top: 1px solid var(--line);
  }

  .band-head {
    display: flex;
    margin-bottom: 46px;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
  }

  .band-head > div:first-child {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  .section-index,
  .skill-index {
    color: var(--ink-faint);
    font: 10px var(--mono);
  }

  .band-head > p,
  .band-side {
    max-width: 470px;
  }

  .band-head p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.75;
  }

  .band-side a {
    display: inline-block;
    margin-top: 12px;
    color: var(--accent);
    font-size: 13px;
    text-decoration: none;
  }

  .system-feature {
    min-height: 0;
    border-block: 1px solid var(--line);
  }

  .system-copy {
    max-width: 760px;
    padding: 62px 36px 68px 0;
  }

  .status {
    color: var(--accent);
    font: 10px var(--mono);
  }

  .system-copy h2 {
    margin: 18px 0;
    font-size: clamp(60px, 8vw, 104px);
    line-height: 0.92;
  }

  .system-copy h2 em {
    color: var(--accent);
    font-style: normal;
  }

  .system-copy > p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 18px;
    line-height: 1.8;
  }

  .project-tags {
    display: flex;
    margin-top: 26px;
    flex-wrap: wrap;
    gap: 8px 18px;
    color: var(--ink-faint);
    font: 10px var(--mono);
  }

  .project-tags span::before {
    margin-right: 7px;
    color: var(--accent);
    content: "·";
  }

  .system-link {
    display: inline-block;
    margin-top: 42px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
  }

  .system-link:hover {
    color: var(--accent);
  }

  .system-feature-iloop {
    display: grid;
    grid-template-columns: minmax(0, 0.66fr) minmax(760px, 1.34fr);
    align-items: center;
    gap: clamp(24px, 4vw, 72px);
  }

  .system-feature-iloop .system-copy {
    max-width: 560px;
    padding-right: 0;
  }

  :global(.system-galaxy .galaxy-wrap) {
    max-width: none;
  }

  :global(.system-galaxy .galaxy) {
    min-height: 440px;
  }

  .skill-list {
    border-top: 1px solid var(--line);
  }

  .skill-row {
    display: grid;
    padding-block: 34px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px;
    border-bottom: 1px solid var(--line);
  }

  .skill-main {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 22px;
    color: inherit;
    text-decoration: none;
  }

  .skill-main h2 {
    margin: 9px 0 8px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.1;
  }

  .skill-main p {
    max-width: 700px;
    margin: 0;
    color: var(--ink-dim);
    font-size: 15px;
    line-height: 1.75;
  }

  .skill-actions {
    display: flex;
    padding-bottom: 4px;
    gap: 22px;
  }

  .skill-actions a {
    color: var(--ink-dim);
    font-size: 12px;
    text-decoration: none;
  }

  .skill-actions a:hover,
  .skill-main:hover h2 {
    color: var(--accent);
  }

  .experiment-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
  }

  .experiment-list a {
    padding: 32px;
    background: var(--bg);
    color: inherit;
    text-decoration: none;
  }

  .experiment-list h2 {
    margin: 0 0 12px;
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 400;
  }

  .experiment-list p {
    margin: 0;
    color: var(--ink-dim);
  }

  .projects-future {
    padding-block: 90px 120px;
    border-top: 1px solid var(--line);
  }

  .projects-future p {
    margin: 14px 0 0;
    color: var(--ink-dim);
    font-family: var(--serif);
    font-size: 28px;
  }

  @media (max-width: 820px) {
    .band-head {
      display: grid;
      gap: 22px;
    }

    .system-copy {
      padding: 44px 0 50px;
    }

    .system-feature-iloop {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .system-feature-iloop .system-copy {
      max-width: 720px;
    }

    :global(.system-galaxy) {
      padding-bottom: 28px;
    }

    .skill-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .skill-actions {
      padding-left: 92px;
    }
  }

  @media (max-width: 560px) {
    .projects-intro {
      padding-block: 64px 70px;
    }

    .projects-intro h1 {
      font-size: 56px;
    }

    .portfolio-band {
      padding-block: 58px 68px;
    }

    .system-copy h2 {
      font-size: 70px;
    }

    :global(.system-galaxy .galaxy) {
      min-height: 390px;
    }

    .skill-main {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .skill-actions {
      padding-left: 0;
    }

    .experiment-list {
      grid-template-columns: 1fr;
    }
  }
</style>
