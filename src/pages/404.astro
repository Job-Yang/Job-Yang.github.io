---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpaceModel from '../components/SpaceModel.astro';
---

<BaseLayout title="页面不存在" description="这个页面已经漂出航线。">
  <div class="space-fallback lost-background" slot="background">
    <SpaceModel model="probe" class="lost-probe" />
  </div>
  <section class="not-found reading">
    <div class="eyebrow">404 / Lost in Space</div>
    <h1 class="display">这个页面<br />已经漂出航线。</h1>
    <p>链接可能已经变更，或者内容尚未公开。</p>
    <a class="pill" href="/">返回首页 →</a>
  </section>
</BaseLayout>

<style>
  .lost-background {
    overflow: hidden;
  }

  :global(.space-model.lost-probe) {
    position: absolute;
    top: 4vh;
    right: 0;
    width: min(58vw, 840px);
    height: 82vh;
    opacity: 0.72;
    transform: rotate(-7deg);
    mask-image: linear-gradient(90deg, transparent, black 26%);
  }

  .not-found {
    position: relative;
    z-index: 2;
    min-height: 72vh;
    padding-block: 14vh;
  }

  h1 {
    margin: 20px 0 22px;
    font-size: clamp(48px, 8vw, 76px);
    line-height: 1.08;
  }

  p {
    margin-bottom: 32px;
    color: var(--ink-dim);
  }

  @media (max-width: 720px) {
    :global(.space-model.lost-probe) {
      top: 16vh;
      right: -40vw;
      width: 110vw;
      height: 66vh;
      opacity: 0.42;
    }
  }
</style>
