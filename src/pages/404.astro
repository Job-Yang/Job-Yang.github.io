---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个页面已经漂出航线。">
  <div class="space-fallback" slot="background"></div>
  <section class="not-found reading">
    <div class="eyebrow">404 / Lost in Space</div>
    <h1 class="display">这个页面<br />已经漂出航线。</h1>
    <p>链接可能已经变更，或者内容尚未公开。</p>
    <a class="pill" href="/">返回首页 →</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    z-index: 2;
    min-height: 72vh;
    padding-block: 14vh;
  }

  h1 {
    margin: 20px 0 22px;
    font-size: clamp(48px, 8vw, 76px);
    line-height: 1.08;
  }

  p {
    margin-bottom: 32px;
    color: var(--ink-dim);
  }
</style>
